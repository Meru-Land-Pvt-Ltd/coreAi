{
  "name": "coreai-marketplace",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "predev": "npm run build:shared && npm run prisma:migrate:deploy && npm run prisma:generate",
    "dev": "node scripts/dev.mjs",
    "dev:shared": "npm run dev --workspace=@coreai/shared",
    "dev:frontend": "npm run dev --workspace=@coreai/frontend",
    "dev:backend": "npm run dev --workspace=@coreai/backend",
    "dev:telegram-worker": "npm run dev:telegram-worker --workspace=@coreai/backend",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "npm run build --workspace=@coreai/shared",
    "build:frontend": "npm run build --workspace=@coreai/frontend",
    "build:backend": "npm run build --workspace=@coreai/backend",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:frontend": "npm run typecheck --workspace=@coreai/frontend",
    "typecheck:backend": "npm run typecheck --workspace=@coreai/backend",
    "lint": "npm run lint:frontend",
    "lint:frontend": "npm run lint --workspace=@coreai/frontend",
    "prisma:generate": "npm run prisma:generate --workspace=@coreai/backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@coreai/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@coreai/backend",
    "prisma:studio": "npm run prisma:studio --workspace=@coreai/backend",
    "reconcile:payouts": "npm run reconcile:payouts --workspace=@coreai/backend --",
    "seed:calling-agents": "npm run seed:calling-agents --workspace=@coreai/backend --",
    "backfill:architect-earnings": "npm run backfill:architect-earnings --workspace=@coreai/backend --",
    "clean": "rm -rf node_modules package-lock.json apps/frontend/node_modules apps/backend/node_modules apps/frontend/.next apps/backend/dist",
    "clean:apple": "find . -name '._*' -delete",
    "reinstall": "npm run clean && npm install",
    "postinstall": "npm run build:shared"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^1.24.0",
    "pdfkit": "^0.19.1",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
