# ---- Core ----
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://user:password@localhost:5432/coreai
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7
ENCRYPTION_KEY=change-me-to-a-long-random-string
PLATFORM_COMMISSION_PERCENT=15
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8787

# ---- Google (Calendar + Gmail OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Twilio (platform-owned telephony) ----
TWILIO_ACCOUNT_SID=
# Auth token: required for webhook SIGNATURE VALIDATION. REST calls prefer the API key below.
TWILIO_AUTH_TOKEN=
# Standard API Key (SK...) + secret — preferred REST auth in production (not the Main key).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# LEGACY/dev fallback only. Production numbers live in the PlatformPhoneNumber table:
#   npm run seed:platform-phone-numbers --workspace=@coreai/backend -- --number=+1... --sid=PN...
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TEST_MODE=false
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_DEFAULT_BUSINESS_NAME=
TWILIO_FORWARD_TO_PHONE=
TWILIO_FORWARD_TIMEOUT_SECONDS=20
TWILIO_DEFAULT_BOOKING_URL=
TWILIO_DEFAULT_TEAM_PHONE=
TWILIO_NUMBER_POOL=

# ---- Vapi (live voice agent platform) ----
VAPI_API_KEY=
VAPI_BASE_URL=https://api.vapi.ai
VAPI_DEFAULT_ASSISTANT_ID=
VAPI_DEFAULT_PHONE_NUMBER_ID=
VAPI_ANSWER_INBOUND=false

VAPI_DEFAULT_VOICE_PROVIDER=11labs
VAPI_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_SARAH_ID=
ELEVENLABS_VOICE_ARIA_ID=
ELEVENLABS_VOICE_RACHEL_ID=
ELEVENLABS_VOICE_ADAM_ID=
ELEVENLABS_VOICE_PRIYA_ID=

# ---- Stripe (billing) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_AI_RECEPTIONIST_MONTHLY=

# ---- Email (SMTP — verification codes + notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_TO=
VERIFICATION_CODE_EXPIRATION_MINUTES=10
# Links used inside outgoing emails (fall back to APP_URL-based paths).
APP_URL=
CORE_HELP_URL=
CORE_PRIVACY_URL=
CORE_TERMS_URL=
CORE_UNSUBSCRIBE_URL=

# ---- Firebase Admin (optional auth integration) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
