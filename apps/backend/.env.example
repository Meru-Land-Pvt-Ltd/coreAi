# Triven Backend environment (see src/config/env.ts for the full zod schema)
# Copy to .env and fill in real values. Never commit .env.

# ------------------------------------------------------------------
# Core
# ------------------------------------------------------------------
NODE_ENV=development
PORT=8787

# Required
DATABASE_URL=postgresql://coreai:password@localhost:5432/coreai
# Optional
REDIS_URL=redis://localhost:6379
PRISMA_LOG_QUERIES=false

# Required — min 24 characters each
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7
ENCRYPTION_KEY=change-me-to-a-long-random-string

# DEPRECATED — never read by any code path. The live marketplace split is the
# versioned settlement calculator (v1 = architect 70% / platform 30%) in
# apps/backend/src/modules/payouts/settlement-calculator.ts. Changing the split
# requires a new calculation version, not this variable.
PLATFORM_COMMISSION_PERCENT=15

# In production these must be public https URLs (e.g. https://triven.ai and https://triven.ai/api)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8787

# ------------------------------------------------------------------
# Google OAuth / Calendar
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=America/Los_Angeles

# ------------------------------------------------------------------
# Twilio (required in production)
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Legacy single-number fallback — production routing should use DB-managed
# PlatformPhoneNumber + BusinessPhoneNumber instead.
TWILIO_PHONE_NUMBER=
TWILIO_PHONE_NUMBER_SID=

# Shared Triven SMS: ALL transactional SMS goes through one global Messaging
# Service + one shared sender. Buyer voice numbers are never SMS senders.
# Production: TWILIO_MESSAGING_SERVICE_SID=MG3159ba3a6f1e33f025f7e80186bf442f
TWILIO_MESSAGING_SERVICE_SID=
# Production: TWILIO_SHARED_SMS_NUMBER=+17252202182 (reserved — never assigned to a buyer)
TWILIO_SHARED_SMS_NUMBER=
# Production: https://triven.ai/api/architect/connectors/twilio/message-status
TWILIO_SMS_STATUS_CALLBACK_URL=
# Explicit SMS mode: SIMULATED (no Twilio request at all) |
# TWILIO_TEST_CREDENTIALS (test account + magic numbers, never delivered) |
# LIVE (shared Messaging Service). Must be LIVE in production.
TWILIO_SMS_MODE=SIMULATED
# Twilio TEST credentials — used ONLY when TWILIO_SMS_MODE=TWILIO_TEST_CREDENTIALS
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
# DEPRECATED — use TWILIO_SMS_MODE. true maps to SIMULATED. Must be false in production.
TWILIO_TEST_MODE=false
# Must be true in production
TWILIO_VALIDATE_SIGNATURE=false
# App-level auto-replies to inbound STOP/HELP keywords. Keep false when the
# Messaging Service has (Advanced) Opt-Out enabled — Twilio replies itself and
# an app reply would duplicate it. Consent-DB syncing happens regardless.
SMS_KEYWORD_APP_REPLIES=false

# Dev/demo defaults for the AI Receptionist flow
TWILIO_DEFAULT_BUSINESS_NAME=
TWILIO_FORWARD_TO_PHONE=
TWILIO_FORWARD_TIMEOUT_SECONDS=20
TWILIO_DEFAULT_BOOKING_URL=
TWILIO_DEFAULT_TEAM_PHONE=
# Comma-separated E.164 numbers available for assignment
TWILIO_NUMBER_POOL=

# ------------------------------------------------------------------
# Vapi AI (voice receptionist)
# ------------------------------------------------------------------
VAPI_API_KEY=
# Shared secret Vapi sends back on webhook calls (Bearer or X-Vapi-Secret)
VAPI_WEBHOOK_SECRET=
# Frontend-safe public key for browser web calls (Architect test)
VAPI_PUBLIC_KEY=
VAPI_BASE_URL=https://api.vapi.ai

# Keep blank in production; per-agent IDs live in InstalledAgent.configJson
VAPI_DEFAULT_ASSISTANT_ID=
VAPI_DEFAULT_PHONE_NUMBER_ID=

VAPI_DEFAULT_VOICE_PROVIDER=vapi
VAPI_DEFAULT_VOICE_ID=Savannah
VAPI_ELEVENLABS_MODEL=eleven_flash_v2_5
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_ENABLE_BOOKING_TOOLS=true
VAPI_ANSWER_INBOUND=false

# ------------------------------------------------------------------
# ElevenLabs voices
# ------------------------------------------------------------------
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-2
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_VOICE_RUBY_ID=
ELEVENLABS_VOICE_SARAH_ID=
ELEVENLABS_VOICE_ARIA_ID=
ELEVENLABS_VOICE_ADAM_ID=
ELEVENLABS_VOICE_PRIYA_ID=
ELEVENLABS_VOICE_RACHEL_ID=

# Smart Memory Node (pgvector). Embeddings need OPENAI_API_KEY; without it
# memory falls back to raw pass-through and never breaks a workflow.
MEMORY_VECTOR_THRESHOLD_TOKENS=1000000
# Chunks returned by similarity search
MEMORY_VECTOR_TOP_K=20
# OpenAI embedding model — must produce 1536-dim vectors
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# Per-scope chunk backstop
MEMORY_MAX_CHUNKS_PER_SCOPE=5000
# Chunks embedded per background/backfill call
MEMORY_EMBED_MAX_PER_CALL=256
# Per-tenant stored-token cap
MEMORY_MAX_TOKENS_PER_TENANT=50000000
# Delete memory records older than N days (0 disables)
MEMORY_RETENTION_DAYS=365
# Shorter retention for test-session memory (0 disables)
MEMORY_TEST_RETENTION_DAYS=30

# ------------------------------------------------------------------
# AI Provider Engine & Testing
# ------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Optional LangChain default models (fall back to gpt-4o-mini / claude-sonnet-4-5 / gemini-2.0-flash)
OPENAI_DEFAULT_MODEL=
ANTHROPIC_DEFAULT_MODEL=
GEMINI_DEFAULT_MODEL=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
STABILITY_API_KEY=
LLAMA_BASE_URL=http://localhost:11434/v1

ARCHITECT_TEST_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# Stripe
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_ID_AI_RECEPTIONIST_MONTHLY=

# Stripe Connect onboarding return/refresh URLs. Optional — default to
# FRONTEND_URL/architect/payouts. In production they must be https://triven.ai/... URLs.
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=

# ------------------------------------------------------------------
# Architect earnings & payouts policy
# ------------------------------------------------------------------
# Days a settled earning stays on hold before it can be released for transfer.
ARCHITECT_EARNING_HOLD_DAYS=7
# Smallest single earning transfer to a connected account, in minor units.
ARCHITECT_MINIMUM_TRANSFER_AMOUNT_MINOR=100
# Smallest manual payout an architect may request, in minor units.
ARCHITECT_MINIMUM_PAYOUT_AMOUNT_MINOR=500
ARCHITECT_DEFAULT_PAYOUT_CURRENCY=usd
# Max payout requests that may be in flight at once per architect.
ARCHITECT_PAYOUT_MAX_ACTIVE_REQUESTS=3
# Minutes after which a reservation that never reached Stripe counts as stuck.
ARCHITECT_PAYOUT_RESERVATION_TIMEOUT_MINUTES=60
# When true, the hourly release cycle also transfers released earnings to
# connected accounts automatically. Default false: transfers happen only when
# an architect requests a payout.
ARCHITECT_AUTO_TRANSFER_ENABLED=false

# When false, all authenticated business owners may deploy agents regardless
# of Stripe subscription state. Stripe billing keeps recording real values
# either way. Accepts true/false/1/0. Current platform policy: false.
ENFORCE_AGENT_SUBSCRIPTION=false

# ------------------------------------------------------------------
# Email — Amazon SES (src/lib/mailer.ts platform mail + src/modules/email proxy mail)
# See apps/backend/docs/mail-setup-ses.md for the full AWS/DNS setup.
# ------------------------------------------------------------------
MAIL_PROVIDER=ses
SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Platform senders (verified identities on your SES account)
SES_FROM_NO_REPLY=
SES_FROM_BILLING=
SES_FROM_CONFIRM=
SES_FROM_SUPPORT=
SES_REPLY_TO=
# Buyer proxy mail (per-business aliases)
SES_FROM_DOMAIN=reply.triven.ai
SES_MAIL_FROM_DOMAIN=bounce.reply.triven.ai
SES_CONFIGURATION_SET=triven-transactional
SES_INBOUND_BUCKET=triven-ses-inbound-emails
SES_INBOUND_TOPIC_ARN=
SES_EVENTS_TOPIC_ARN=
# Dev-only: log emails instead of sending / accept unsigned SNS test payloads.
# Both are ignored in production (SNS verification is always enforced there).
SES_DRY_RUN=false
SES_SNS_VERIFY=true
VERIFICATION_CODE_EXPIRATION_MINUTES=10

# Optional email footer/branding links (default to FRONTEND_URL paths)
TRIVEN_PRIVACY_URL=
TRIVEN_TERMS_URL=
TRIVEN_CONTACT_URL=
TRIVEN_LOGO_URL=
TRIVEN_LOGO_PATH=

# ------------------------------------------------------------------
# Firebase Admin (src/lib/firebase-admin.ts)
# ------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

GOOGLE_WORKSPACE_AI_PROCESSING_ENABLED=false
VAPI_WORKSPACE_NO_TRAINING_CONFIRMED=false
VAPI_HIPAA_OR_ZDR_CONFIRMED=false
OPENAI_NO_TRAINING_CONFIRMED=false
OPENAI_DATA_SHARING_DISABLED_CONFIRMED=false
ANTHROPIC_NO_TRAINING_CONFIRMED=false
ANTHROPIC_FEEDBACK_SHARING_DISABLED_CONFIRMED=false
GEMINI_PAID_SERVICE_CONFIRMED=false
GEMINI_DATASET_SHARING_DISABLED_CONFIRMED=false
DEEPGRAM_MIP_OPT_OUT_CONFIRMED=false
ELEVENLABS_TRAINING_OPT_OUT_CONFIRMED=false
ELEVENLABS_ZRM_CONFIRMED=false
