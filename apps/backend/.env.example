# CoreAI Backend environment (see src/config/env.ts for the full zod schema)
# Copy to .env and fill in real values. Never commit .env.

# ------------------------------------------------------------------
# Core
# ------------------------------------------------------------------
NODE_ENV=development
PORT=8787

# Required
DATABASE_URL=postgresql://coreai:password@localhost:5432/coreai
# Optional
REDIS_URL=redis://localhost:6379
PRISMA_LOG_QUERIES=false

# Required — min 24 characters each
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7
ENCRYPTION_KEY=change-me-to-a-long-random-string

PLATFORM_COMMISSION_PERCENT=15

# In production these must be public https URLs (e.g. https://triven.ai and https://triven.ai/api)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8787

# ------------------------------------------------------------------
# Google OAuth / Calendar
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=America/Los_Angeles

# ------------------------------------------------------------------
# Twilio (required in production)
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Legacy single-number fallback — production routing should use DB-managed
# PlatformPhoneNumber + BusinessPhoneNumber instead.
TWILIO_PHONE_NUMBER=
TWILIO_PHONE_NUMBER_SID=

TWILIO_MESSAGING_SERVICE_SID=
# Must be false in production
TWILIO_TEST_MODE=false
# Must be true in production
TWILIO_VALIDATE_SIGNATURE=false

# Dev/demo defaults for the AI Receptionist flow
TWILIO_DEFAULT_BUSINESS_NAME=
TWILIO_FORWARD_TO_PHONE=
TWILIO_FORWARD_TIMEOUT_SECONDS=20
TWILIO_DEFAULT_BOOKING_URL=
TWILIO_DEFAULT_TEAM_PHONE=
# Comma-separated E.164 numbers available for assignment
TWILIO_NUMBER_POOL=

# ------------------------------------------------------------------
# Vapi AI (voice receptionist)
# ------------------------------------------------------------------
VAPI_API_KEY=
# Shared secret Vapi sends back on webhook calls (Bearer or X-Vapi-Secret)
VAPI_WEBHOOK_SECRET=
# Frontend-safe public key for browser web calls (Architect test)
VAPI_PUBLIC_KEY=
VAPI_BASE_URL=https://api.vapi.ai

# Keep blank in production; per-agent IDs live in InstalledAgent.configJson
VAPI_DEFAULT_ASSISTANT_ID=
VAPI_DEFAULT_PHONE_NUMBER_ID=

VAPI_DEFAULT_VOICE_PROVIDER=vapi
VAPI_DEFAULT_VOICE_ID=Savannah
VAPI_ELEVENLABS_MODEL=eleven_flash_v2_5
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_ENABLE_BOOKING_TOOLS=true
VAPI_ANSWER_INBOUND=false

# ------------------------------------------------------------------
# ElevenLabs voices
# ------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_VOICE_RUBY_ID=
ELEVENLABS_VOICE_SARAH_ID=
ELEVENLABS_VOICE_ARIA_ID=
ELEVENLABS_VOICE_ADAM_ID=
ELEVENLABS_VOICE_PRIYA_ID=
ELEVENLABS_VOICE_RACHEL_ID=

# ------------------------------------------------------------------
# AI Provider Engine & Testing
# ------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Optional LangChain default models (fall back to gpt-4o-mini / claude-sonnet-4-5 / gemini-2.0-flash)
OPENAI_DEFAULT_MODEL=
ANTHROPIC_DEFAULT_MODEL=
GEMINI_DEFAULT_MODEL=
MISTRAL_API_KEY=
STABILITY_API_KEY=
LLAMA_BASE_URL=http://localhost:11434/v1
ELEVENLABS_API_KEY=

ARCHITECT_TEST_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# Stripe
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_ID_AI_RECEPTIONIST_MONTHLY=

# ------------------------------------------------------------------
# SMTP / transactional email (src/lib/mailer.ts)
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when unset
SMTP_FROM=
VERIFICATION_CODE_EXPIRATION_MINUTES=10

# Optional email footer/branding links (default to FRONTEND_URL paths)
CORE_PRIVACY_URL=
CORE_TERMS_URL=
CORE_CONTACT_URL=
TRIVEN_LOGO_URL=
TRIVEN_LOGO_PATH=

# ------------------------------------------------------------------
# Firebase Admin (src/lib/firebase-admin.ts)
# ------------------------------------------------------------------
