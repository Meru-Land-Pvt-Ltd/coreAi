# =========================
# Core / URLs
# =========================
NODE_ENV=production

FRONTEND_URL=https://triven.ai
BACKEND_URL=https://triven.ai/api

# Frontend browser API path
NEXT_PUBLIC_API_URL=/api

# Internal Docker/backend URL if frontend/server needs internal calls
API_INTERNAL_URL=http://backend:8787

APP_URL=https://triven.ai


# =========================
# Database
# =========================
POSTGRES_DB=coreai
POSTGRES_USER=coreai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# URL-encode special characters in password
DATABASE_URL=postgresql://coreai:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/coreai


# =========================
# Auth / Encryption
# Generate fresh 64+ char random values
# =========================
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_ENCRYPTION_KEY
JWT_EXPIRES_IN_DAYS=7


# =========================
# Google OAuth / Calendar
# Google Cloud redirect URI must exactly match this:
# https://triven.ai/api/architect/connectors/gmail/callback
# =========================
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GMAIL_OAUTH_REDIRECT_URI=https://triven.ai/api/architect/connectors/gmail/callback

GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=Asia/Kolkata


# =========================
# Twilio Credentials
# IMPORTANT:
# Do NOT put Twilio phone numbers here for production.
# Phone numbers are stored in DB: PlatformPhoneNumber / BusinessPhoneNumber.
# =========================
TWILIO_ACCOUNT_SID=AC_CHANGE_ME
TWILIO_API_KEY_SID=SK_CHANGE_ME
TWILIO_API_KEY_SECRET=CHANGE_ME_TWILIO_API_KEY_SECRET

# Needed for Twilio webhook signature validation
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN

TWILIO_VALIDATE_SIGNATURE=true
TWILIO_TEST_MODE=false

# Optional only if SMS messaging service is used
TWILIO_MESSAGING_SERVICE_SID=

TWILIO_FORWARD_TIMEOUT_SECONDS=20


# =========================
# Vapi
# Live voice assistant/calls
# =========================
VAPI_API_KEY=CHANGE_ME_VAPI_API_KEY
VAPI_BASE_URL=https://api.vapi.ai

# Legacy fallback only; prefer buyer-deployed assistants
VAPI_DEFAULT_ASSISTANT_ID=
VAPI_DEFAULT_PHONE_NUMBER_ID=

VAPI_DEFAULT_VOICE_PROVIDER=11labs
VAPI_DEFAULT_VOICE_ID=CHANGE_ME_ELEVENLABS_VOICE_ID


# =========================
# ElevenLabs
# Used for voice preview / default voice IDs
# Live calls use ElevenLabs through Vapi
# =========================
ELEVENLABS_API_KEY=CHANGE_ME_ELEVENLABS_API_KEY

ELEVENLABS_VOICE_SARAH_ID=
ELEVENLABS_VOICE_ARIA_ID=
ELEVENLABS_VOICE_RACHEL_ID=
ELEVENLABS_VOICE_ADAM_ID=
ELEVENLABS_VOICE_PRIYA_ID=


# =========================
# Stripe
# Backend only. Never put secret key in frontend env.
# =========================
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_ID_AI_RECEPTIONIST_MONTHLY=price_CHANGE_ME

FIREBASE_PROJECT_ID=triven-ai-713a6
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@triven-ai-713a6.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nNEW_ROTATED_KEY_ONLY\n-----END PRIVATE KEY-----\n"


# =========================
# SMTP / Email
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_EMAIL
SMTP_PASS="CHANGE_ME_APP_PASSWORD"

MAIL_TO=CHANGE_ME_EMAIL
MAIL_FROM_NAME=Triven.ai

VERIFICATION_CODE_EXPIRATION_MINUTES=10


# =========================
# App links
# =========================
CORE_UNSUBSCRIBE_URL=https://triven.ai/unsubscribe
CORE_PRIVACY_URL=https://triven.ai/privacy
CORE_CONTACT_URL=https://triven.ai/contact
CORE_TERMS_URL=https://triven.ai/terms


# =========================
# Redis
# Currently optional / not actively used by app logic
# =========================
REDIS_URL=redis://redis:6379