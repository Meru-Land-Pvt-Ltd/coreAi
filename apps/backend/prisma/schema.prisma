model VapiCall {
  id                    String                @id @default(cuid())
  businessId            String
  installedAgentId      String?
  conversationId        String?
  callId                String                @unique
  customerPhone         String
  executionMode         String                @default("LIVE")
  status                String                @default("STARTED")
  transcript            String?
  summary               String?
  recordingUrl          String?
  metadataJson          Json?
  durationSeconds       Int?
  durationMinutes       Float?
  smsCount              Int                   @default(0)
  /// Structured understanding (plan Part 2): BOOKED | RESCHEDULED | CANCELLED |
  /// LEAD | FOLLOW_UP | NO_INTEREST | MISSED | TRANSFERRED | SUPPORT_RESOLVED | UNKNOWN
  outcome               String?
  /// POSITIVE | NEUTRAL | CONFUSED | FRUSTRATED | ANGRY | UNKNOWN
  sentiment             String?
  /// Canonical Customer.id (per business). Plain indexed link — no FK.
  customerId            String?
  /// Durable fallback for the Redis transfer context (Twilio leg of this call).
  twilioCallSid         String?
  /// Retention/deletion state for the provider-hosted recording:
  /// null (kept) | PENDING_DELETE | DELETED | DELETE_FAILED | UNSUPPORTED
  providerDeletionState String?
  recordingDeletedAt    DateTime?
  vapiCostMicroUsd      Int?
  actualCostMicroUsd    Int?
  billedCostMicroUsd    Int?
  usageLineItemsJson    Json?
  vapiCostBreakdownJson Json?
  pricingSnapshotJson   Json?
  pricingState          String                @default("PENDING")
  billingMonth          String?
  billingRecordedAt     DateTime?
  usageInvoiceId        String?
  startedAt             DateTime              @default(now())
  endedAt               DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  usageInvoice          BusinessUsageInvoice? @relation(fields: [usageInvoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, billingMonth])
  @@index([businessId, executionMode])
  @@index([installedAgentId])
  @@index([usageInvoiceId])
  @@index([customerPhone])
  @@index([status])
  @@index([pricingState])
  @@index([customerId])
  @@index([twilioCallSid])
}

model HandoffEvent {
  id                   String           @id @default(cuid())
  businessId           String
  installedAgentId     String?
  /// VOICE | SMS | CHAT | EMAIL
  channel              String           @default("VOICE")
  executionMode        String           @default("LIVE")
  vapiCallId           String?
  twilioCallSid        String?
  customerPhone        String?
  /// E.164 the call was sent to. Resolved server-side only — never model input.
  destination          String?
  reason               String?
  /// customer | ai | policy
  requestedBy          String           @default("customer")
  /// INITIATED | CONNECTED | NO_ANSWER | FAILED | MESSAGE_TAKEN | SIMULATED
  status               String           @default("INITIATED")
  waitSeconds          Int?
  /// BusinessTeamMember.id that took (or was last dialed for) this handoff.
  assignedTeamMemberId String?
  connectedAt          DateTime?
  attemptsCount        Int              @default(0)
  conversationId       String?
  customerId           String?
  metadataJson         Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  resolvedAt           DateTime?
  business             Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  attempts             HandoffAttempt[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([vapiCallId])
  @@index([customerId])
}

model PlatformPhoneNumber {
  id                           String              @id @default(cuid())
  phoneNumber                  String              @unique
  /// Normalized E.164 form of phoneNumber (backfilled; canonical for lookups going forward).
  e164                         String?             @unique
  provider                     ConnectorProvider   @default(TWILIO)
  status                       PlatformPhoneStatus @default(AVAILABLE)
  twilioSid                    String?             @unique
  /// Provider-agnostic number id (alias for twilioSid; future non-Twilio providers).
  providerNumberId             String?
  country                      String?
  region                       String?
  locality                     String?
  /// e.g. { "voice": true, "sms": false, "mms": false }
  capabilities                 Json?
  voiceEnabled                 Boolean             @default(true)
  smsEnabled                   Boolean             @default(true)
  mmsEnabled                   Boolean?
  businessId                   String?
  buyerUserId                  String?
  installedAgentId             String?
  assignedAt                   DateTime?
  /// Legacy one-time billing marker retained for migration compatibility.
  feeBilledAt                  DateTime?
  /// Twilio's account-specific recurring monthly price at the last pricing lookup.
  providerMonthlyPriceMicroUsd Int?
  /// Buyer monthly price: round(provider monthly USD) + 1 USD.
  billingMonthlyPriceMicroUsd  Int?
  pricingCurrency              String?
  pricingNumberType            String?
  pricingFetchedAt             DateTime?
  /// Admin provisioning metadata (numbers purchased through the admin panel).
  purchasedByAdminId           String?
  purchasedAt                  DateTime?
  releasedAt                   DateTime?
  /// The id Vapi gives this number once it is registered there. Present only
  /// on numbers we use to PLACE calls — Vapi refuses to dial from a number it
  /// does not know, and registering one hands its inbound webhook to Vapi.
  vapiPhoneNumberId            String?
  voiceWebhookUrl              String?
  smsWebhookUrl                String?
  webhookStatus                PhoneWebhookStatus  @default(UNKNOWN)
  complianceStatus             String?
  a2pStatus                    String?
  isPlatformSmsSender          Boolean             @default(false)
  lastSyncedAt                 DateTime?
  lastError                    String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  @@index([status])
  @@index([businessId])
  @@index([installedAgentId])
  @@index([isPlatformSmsSender, status])
}

/// Structured record of privileged admin actions (phone provisioning, assignment, release…).
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  metaJson    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model Payment {
  id                               String                 @id @default(cuid())
  userId                           String
  businessId                       String?
  listingId                        String?
  installedAgentId                 String?
  amountCents                      Int                    @default(0)
  currency                         String                 @default("usd")
  /// WHAT THE BUYER ACTUALLY SAW AND PAID.
  ///
  /// Our Stripe objects always report the integration currency — USD — even
  /// when a customer in Zurich paid in francs. Without these two columns the
  /// dashboard, the receipt and the support conversation all disagree with the
  /// buyer's bank statement, and nothing can be reconciled. Null means the
  /// buyer paid in our own currency.
  presentmentAmountCents           Int?
  presentmentCurrency              String?
  status                           PaymentStatus          @default(PENDING)
  architectEarningStatus           ArchitectEarningStatus @default(PENDING)
  architectEarningReviewedAt       DateTime?
  architectEarningReviewedByUserId String?

  stripeCustomerId     String?
  stripeSessionId      String?
  stripeSubscriptionId String?
  stripePaymentId      String?

  billingName    String?
  billingEmail   String?
  billingAddress String?

  description                  String?
  invoiceKind                  PaymentInvoiceKind @default(PURCHASE)
  /// Stable scheduler/idempotency key, for example
  /// "post-trial:<trialPaymentId>" or "subscription:<user>:<listing>:2026-07".
  invoiceKey                   String?            @unique
  periodStart                  DateTime?
  periodEnd                    DateTime?
  dueAt                        DateTime?
  graceEndsAt                  DateTime?
  paidAt                       DateTime?
  canceledAt                   DateTime?
  suspendedAt                  DateTime?
  /// Set after the buyer receives the reminder sent during the final 24 hours.
  trialEndingOneDayEmailSentAt DateTime?
  /// Set only after the buyer's trial-ended lifecycle email is accepted by SES.
  /// A null value lets the hourly billing cycle safely retry failed delivery.
  trialEndedEmailSentAt        DateTime?
  /// One-time gentle reminder for a pending agent invoice.
  pendingReminderSentAt        DateTime?
  pendingReminderCount         Int                @default(0)
  paymentAttemptCount          Int                @default(0)
  paymentPendingAt             DateTime?
  /// Buyer-facing fee breakdown: [{ label, amountCents }].
  lineItemsJson                Json?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  business       Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  listing        AgentListing?     @relation(fields: [listingId], references: [id])
  installedAgent InstalledAgent?   @relation(fields: [installedAgentId], references: [id], onDelete: SetNull)
  earning        ArchitectEarning?

  @@index([userId])
  @@index([businessId])
  @@index([listingId])
  @@index([installedAgentId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSessionId])
  @@index([stripeSubscriptionId])
}

model TemplateRequest {
