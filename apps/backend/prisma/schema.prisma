  @@index([status])
}

model ArchitectEarning {
  id                       String                 @id @default(cuid())
  architectUserId          String
  buyerUserId              String?
  listingId                String?
  paymentId                String                 @unique
  currency                 String                 @default("usd")
  grossAmountCents         Int
  platformCommissionCents  Int
  architectGrossCents      Int
  refundCents              Int                    @default(0)
  disputeCents             Int                    @default(0)
  reversalCents            Int                    @default(0)
  adjustmentCents          Int                    @default(0)
  /// architectGrossCents - refundCents - disputeCents - reversalCents + adjustmentCents.
  architectNetCents        Int
  status                   ArchitectEarningState  @default(PAYMENT_SUCCEEDED)
  /// Status the earning returns to if an open dispute is won.
  statusBeforeDispute      ArchitectEarningState?
  holdUntil                DateTime?
  availableAt              DateTime?
  transferredAt            DateTime?
  livemode                 Boolean                @default(false)
  stripePaymentIntentId    String?
  stripeChargeId           String?
  stripeTransferId         String?                @unique
  stripeTransferReversalId String?
  calculationVersion       Int                    @default(1)
  settlementVersion        Int                    @default(1)
  lastStripeEventCreatedAt DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  architect                User                   @relation(fields: [architectUserId], references: [id], onDelete: Cascade)
  payment                  Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  ledgerEntries            ArchitectLedgerEntry[]

  @@index([architectUserId, status])
  @@index([status, holdUntil])
  @@index([listingId])
  @@index([stripePaymentIntentId])
  @@index([livemode])
}

model ArchitectLedgerEntry {
  id              String                   @id @default(cuid())
  earningId       String?
  architectUserId String
  entryType       ArchitectLedgerEntryType
  amountCents     Int
  currency        String                   @default("usd")
  reason          String
  source          String
  sourceId        String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  earning         ArchitectEarning?        @relation(fields: [earningId], references: [id], onDelete: SetNull)
  architect       User                     @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@unique([entryType, sourceId, earningId])
  @@index([earningId])
  @@index([architectUserId, createdAt])
}

model StripeWebhookEvent {
  id                 String                        @id @default(cuid())
  stripeEventId      String                        @unique
  eventType          String
  connectedAccountId String?
  livemode           Boolean                       @default(false)
  objectId           String?
  eventCreatedAt     DateTime
  processingStatus   StripeWebhookProcessingStatus @default(RECEIVED)
  attemptCount       Int                           @default(1)
  lastErrorCode      String?
  processedAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([eventType, createdAt])
  @@index([objectId])
  @@index([processingStatus])
}

