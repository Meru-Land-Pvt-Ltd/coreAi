generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                       @id @default(cuid())
  email                String
  passwordHash         String?
  role                 UserRole
  fullName             String?
  phone                String?
  location             String?
  timezone             String?
  profilePhotoUrl      String?
  isSuspended          Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  listings             AgentListing[]
  architectProfile     ArchitectProfile?
  businesses           Business[]
  connectorCredentials ConnectorCredential[]
  payments             Payment[]
  proposals            ProjectProposal[]
  templateRequests     TemplateRequest[]
  workflows            WorkflowDefinition[]
  workflowRuns         WorkflowRun[]
  payoutMethod         ArchitectPayoutMethod?
  backupPayoutMethod   ArchitectBackupPayoutMethod?
  payouts              ArchitectPayout[]
  loginHistory         UserLoginHistory[]
  activeSessions       UserActiveSession[]

  // Same email may exist once per role (e.g. BUSINESS + ARCHITECT), but not twice
  // for the same role.
  @@unique([email, role])
  @@index([role])
  @@index([createdAt])
}

model ArchitectProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  title               String?
  displayName         String?
  marketplacePhotoUrl String?
  tagline             String?
  bio                 String?
  portfolioUrl        String?
  githubUrl           String?
  linkedinUrl         String?
  twitterHandle       String?
  experienceBand      String?
  skills              String[]
  approvalStatus      ArchitectStatus @default(PENDING)
  rating              Float           @default(0)
  completedJobs       Int             @default(0)
  notificationPrefs   Json?
  privacyPrefs        Json?
  payoutSchedule      Json?
  agentsPaused        Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  hourlyRateCents     Int?
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
}

model WorkflowDefinition {
  id                   String               @id @default(cuid())
  name                 String
  description          String?
  workflowJson         Json
  // Architect Configure flow (marketplace template metadata) — optional so
  // existing workflows keep working with safe defaults.
  configureJson        Json?
  marketplaceJson      Json?
  requiredIntegrations Json?
  buyerSetupSchema     Json?
  publishChecklist     Json?
  reviewStatus         ListingReviewStatus  @default(DRAFT)
  publishStatus        ListingPublishStatus @default(DRAFT)
  isTemplate           Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  architectUserId      String
  listings             AgentListing[]
  installedAgents      InstalledAgent[]
  workflowRuns         WorkflowRun[]
  architect            User                 @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([architectUserId])
  @@index([createdAt])
}

model AgentListing {
  id                     String               @id @default(cuid())
  name                   String
  shortDescription       String
  description            String?
  priceCents             Int                  @default(0)
  status                 ListingStatus        @default(DRAFT)
  requiredConnectors     String[]
  supportedLlms          String[]
  tags                   String[]
  // Marketplace configure/publish metadata (Architect Configure flow). All
  // optional or defaulted so pre-existing listings stay valid.
  tagline                String?
  category               String?
  industryTags           String[]             @default([])
  iconUrl                String?
  fullDescription        String?
  includedFeatures       String[]             @default([])
  screenshotUrls         String[]             @default([])
  demoVideoUrl           String?
  pricingModel           PricingModel         @default(SUBSCRIPTION)
  executionFeeCents      Int                  @default(0)
  freeTrialEnabled       Boolean              @default(false)
  trialDays              Int                  @default(0)
  setupTimeEstimate      String?
  requiredIntegrations   Json?
  requiredBuyerSetup     Json?
  buyerSetupInstructions String?
  installInstructions    String?
  dataHandling           Json?
  complianceChecks       Json?
  reviewStatus           ListingReviewStatus  @default(DRAFT)
  publishStatus          ListingPublishStatus @default(DRAFT)
  rejectionReason        String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  publishedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  architectUserId        String
  workflowId             String?
  architect              User                 @relation(fields: [architectUserId], references: [id], onDelete: Cascade)
  workflow               WorkflowDefinition?  @relation(fields: [workflowId], references: [id])
  installedAgents        InstalledAgent[]
  payments               Payment[]

  @@index([architectUserId])
  @@index([workflowId])
  @@index([status])
}

model Project {
  id                 String            @id @default(cuid())
  title              String
  requirementBrief   String
  requiredConnectors String[]
  preferredLlms      String[]
  budgetMinCents     Int?
  budgetMaxCents     Int?
  status             ProjectStatus     @default(OPEN)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  proposals          ProjectProposal[]

  @@index([status])
  @@index([createdAt])
}

model ProjectProposal {
  id              String         @id @default(cuid())
  projectId       String
  architectUserId String
  coverLetter     String
  bidAmountCents  Int?
  etaDays         Int?
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  architect       User           @relation(fields: [architectUserId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, architectUserId])
  @@index([architectUserId])
  @@index([projectId])
  @@index([status])
}

model ConnectorCredential {
  id                   String            @id @default(cuid())
  userId               String
  provider             ConnectorProvider
  externalAccountEmail String?
  accessTokenEnc       String?
  refreshTokenEnc      String?
  scope                String?
  tokenType            String?
  expiresAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  email      String
  role       UserRole
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email, role])
  @@index([expiresAt])
  @@index([createdAt])
}

model Business {
  id                String   @id @default(cuid())
  ownerId           String
  name              String
  type              String
  /// URL-safe slug for the public booking/service-request page (/book/[slug]).
  publicBookingSlug String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Stripe billing (AI Receptionist subscription).
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   @default("active")
  subscriptionPriceId  String?
  currentPeriodEnd     DateTime?

  billingName       String?
  billingEmail      String?
  billingAddress    String?
  billingPostalCode String?

  appointments    Appointment[]
  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  knowledgeBases  BusinessKnowledgeBase[]
  phoneNumbers    BusinessPhoneNumber[]
  profile         BusinessProfile?
  conversations   Conversation[]
  installedAgents InstalledAgent[]
  leads           Lead[]
  vapiCalls       VapiCall[]
  usageInvoices   BusinessUsageInvoice[]
  payments        Payment[]
  workflowRuns    WorkflowRun[]
  emailAliases    BusinessEmailAlias[]
  emailMessages   EmailMessage[]
  smsExecutions   SmsExecution[]
  smsConsents     SmsConsent[]

  @@index([ownerId])
  @@index([type])
}

model BusinessProfile {
  id                    String    @id @default(cuid())
  businessId            String    @unique
  serviceArea           String?
  bookingUrl            String?
  teamPhone             String?
  businessSize          String?
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  onboardingDataJson    Json?
  hoursJson             Json?
  tone                  String    @default("friendly")
  escalationRules       String?
  services              String[]
  faqsJson              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  calendarId            String?   @default("primary")
  timeZone              String    @default("America/New_York")
  vapiAssistantId       String?
  vapiPhoneNumberId     String?
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessPhoneNumber {
  id                   String            @id @default(cuid())
  businessId           String
  installedAgentId     String?
  phoneNumber          String            @unique
  provider             ConnectorProvider @default(TWILIO)
  twilioPhoneNumberSid String?
  forwardToPhone       String?
  isActive             Boolean           @default(true)
  configJson           Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  business             Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent       InstalledAgent?   @relation(fields: [installedAgentId], references: [id])

  @@index([businessId])
  @@index([installedAgentId])
  @@index([isActive])
}

model InstalledAgent {
  id           String                @id @default(cuid())
  businessId   String
  workflowId   String
  listingId    String?
  name         String
  status       String                @default("ACTIVE")
  configJson   Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  phoneNumbers BusinessPhoneNumber[]
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing      AgentListing?         @relation(fields: [listingId], references: [id])
  workflow     WorkflowDefinition    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowRuns WorkflowRun[]

  @@unique([businessId, listingId])
  @@index([businessId])
  @@index([workflowId])
  @@index([listingId])
  @@index([status])
}

model BusinessKnowledgeBase {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  content     String
  contentJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Conversation {
  id            String                @id @default(cuid())
  businessId    String
  channel       String
  customerPhone String
  status        String                @default("OPEN")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]

  @@unique([businessId, channel, customerPhone])
  @@index([businessId])
  @@index([customerPhone])
  @@index([channel, customerPhone])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  direction      String
  body           String
  providerId     String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Lead {
  id             String   @id @default(cuid())
  businessId     String
  conversationId String?
  phoneNumber    String
  name           String?
  source         String
  status         String   @default("NEW")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phoneNumber])
  @@index([businessId])
  @@index([phoneNumber])
  @@index([status])
}

model Appointment {
  id                 String    @id @default(cuid())
  businessId         String
  conversationId     String?
  customerPhone      String
  customerName       String?
  service            String?
  startAt            DateTime
  endAt              DateTime
  timeZone           String?
  calendarEventId    String?
  /// Google Calendar event htmlLink — lets the buyer open the booking on the calendar.
  calendarEventLink  String?
  status             String    @default("BOOKED")
  notes              String?
  /// Cancellation audit trail (status CANCELLED).
  cancelledAt        DateTime?
  /// What triggered the cancellation, e.g. CUSTOMER_PHONE_CALL.
  cancellationSource String?
  cancellationReason String?
  /// Vapi call id of the phone call that cancelled this appointment.
  cancellationCallId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerPhone])
  @@index([startAt])
  @@index([calendarEventId])
}

model VapiCall {
  id                    String                @id @default(cuid())
  businessId            String
  installedAgentId      String?
  conversationId        String?
  callId                String                @unique
  customerPhone         String
  status                String                @default("STARTED")
  transcript            String?
  summary               String?
  /// Vapi call recording URL — only present when the workflow's End Flow node has call recording enabled.
  recordingUrl          String?
  metadataJson          Json?
  durationSeconds       Int?
  durationMinutes       Float?
  smsCount              Int                   @default(0)
  /// Vapi-reported total call cost (vendor actual).
  vapiCostMicroUsd      Int?
  /// Sum of admin-board actual vendor rates for this execution.
  actualCostMicroUsd    Int?
  /// Sum of admin-board updated rates — used for buyer billing.
  billedCostMicroUsd    Int?
  usageLineItemsJson    Json?
  vapiCostBreakdownJson Json?
  billingMonth          String?
  billingRecordedAt     DateTime?
  usageInvoiceId        String?
  startedAt             DateTime              @default(now())
  endedAt               DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  usageInvoice          BusinessUsageInvoice? @relation(fields: [usageInvoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, billingMonth])
  @@index([installedAgentId])
  @@index([usageInvoiceId])
  @@index([customerPhone])
  @@index([status])
}

model PlatformPhoneNumber {
  id                  String              @id @default(cuid())
  phoneNumber         String              @unique
  /// Normalized E.164 form of phoneNumber (backfilled; canonical for lookups going forward).
  e164                String?             @unique
  provider            ConnectorProvider   @default(TWILIO)
  status              PlatformPhoneStatus @default(AVAILABLE)
  twilioSid           String?             @unique
  /// Provider-agnostic number id (alias for twilioSid; future non-Twilio providers).
  providerNumberId    String?
  country             String?
  region              String?
  locality            String?
  /// e.g. { "voice": true, "sms": false, "mms": false }
  capabilities        Json?
  voiceEnabled        Boolean             @default(true)
  smsEnabled          Boolean             @default(true)
  mmsEnabled          Boolean?
  businessId          String?
  buyerUserId         String?
  installedAgentId    String?
  assignedAt          DateTime?
  /// When the one-time number fee was billed to the buyer (once per number;
  /// cleared when the number returns to AVAILABLE).
  feeBilledAt         DateTime?
  /// Admin provisioning metadata (numbers purchased through the admin panel).
  purchasedByAdminId  String?
  purchasedAt         DateTime?
  releasedAt          DateTime?
  voiceWebhookUrl     String?
  smsWebhookUrl       String?
  webhookStatus       PhoneWebhookStatus  @default(UNKNOWN)
  complianceStatus    String?
  a2pStatus           String?
  isPlatformSmsSender Boolean             @default(false)
  lastSyncedAt        DateTime?
  lastError           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status])
  @@index([businessId])
  @@index([installedAgentId])
  @@index([isPlatformSmsSender, status])
}

/// Structured record of privileged admin actions (phone provisioning, assignment, release…).
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  metaJson    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model Payment {
  id                               String                 @id @default(cuid())
  userId                           String
  businessId                       String?
  listingId                        String?
  amountCents                      Int                    @default(0)
  currency                         String                 @default("usd")
  status                           PaymentStatus          @default(PENDING)
  architectEarningStatus           ArchitectEarningStatus @default(PENDING)
  architectEarningReviewedAt       DateTime?
  architectEarningReviewedByUserId String?

  stripeCustomerId     String?
  stripeSessionId      String?
  stripeSubscriptionId String?
  stripePaymentId      String?

  billingName    String?
  billingEmail   String?
  billingAddress String?

  description   String?
  /// Buyer-facing fee breakdown: [{ label, amountCents }] — agent price plus
  /// the "AI Receptionist No." number fee when one was provisioned.
  lineItemsJson Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  listing  AgentListing? @relation(fields: [listingId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([listingId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSessionId])
  @@index([stripeSubscriptionId])
}

model TemplateRequest {
  id              String   @id @default(cuid())
  architectUserId String
  industry        String
  description     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  architect User @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([architectUserId])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([subject])
  @@index([createdAt])
}

model Country {
  id          String   @id @default(cuid())
  name        String
  countryCode String   @unique
  flag        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model ArchitectPayoutMethod {
  id                      String   @id @default(cuid())
  architectUserId         String   @unique
  bankName                String?
  accountHolderName       String?
  accountNumber           String? // Legacy only. New Stripe Connect methods never store a full account number.
  ifscCode                String? // Legacy only. Stripe collects IFSC/ABA routing details directly.
  country                 String   @default("IN")
  currency                String   @default("inr")
  accountLast4            String?
  routingLast4            String?
  stripeAccountId         String?  @unique
  stripeExternalAccountId String?
  verificationStatus      String   @default("PENDING")
  payoutsEnabled          Boolean  @default(false)
  detailsSubmitted        Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  architect               User     @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([country])
  @@index([verificationStatus])
}

model ArchitectBackupPayoutMethod {
  id                      String   @id @default(cuid())
  architectUserId         String   @unique
  bankName                String?
  accountHolderName       String?
  country                 String   @default("IN")
  currency                String   @default("inr")
  accountLast4            String?
  routingLast4            String?
  stripeAccountId         String?
  stripeExternalAccountId String?
  verificationStatus      String   @default("PENDING")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  architect               User     @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([country])
}

model ArchitectPayout {
  id               String                @id @default(cuid())
  architectUserId  String
  amountCents      Int
  currency         String                @default("usd")
  status           ArchitectPayoutStatus @default(PENDING)
  stripeTransferId String?               @unique
  stripePayoutId   String?               @unique
  arrivalDate      DateTime?
  failureCode      String?
  failureMessage   String?
  deliveryMethod   String                @default("standard")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  architect        User                  @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([architectUserId])
  @@index([status])
  @@index([createdAt])
}

model UserLoginHistory {
  id          String             @id @default(cuid())
  userId      String
  deviceLabel String
  location    String?
  ipMasked    String?
  userAgent   String?
  status      LoginHistoryStatus @default(SUCCESS)
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UserActiveSession {
  id           String    @id @default(cuid())
  userId       String
  tokenSid     String    @unique
  deviceLabel  String
  location     String?
  ipMasked     String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model ArchitectRefundSettlement {
  id              String                 @id @default(cuid())
  architectUserId String
  action          ArchitectRefundAction
  amountCents     Int
  status          RefundSettlementStatus @default(PENDING)
  breakdown       Json
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([architectUserId])
  @@index([status])
}

enum UserRole {
  ADMIN
  BUSINESS
  ARCHITECT
}

enum ArchitectStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProjectStatus {
  OPEN
  PROPOSAL_REVIEW
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  PAUSED
}

enum ListingReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ListingPublishStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  UNPUBLISHED
}

enum PricingModel {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

enum ArchitectPayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LoginHistoryStatus {
  SUCCESS
  BLOCKED
}

enum ArchitectRefundAction {
  PAUSE_ALL_AGENTS
  DELETE_ACCOUNT
}

enum RefundSettlementStatus {
  PENDING
  PAID
}

enum ConnectorProvider {
  GMAIL
  TWILIO
  GOOGLE_CALENDAR
  VAPI
}

enum PlatformPhoneStatus {
  AVAILABLE
  ASSIGNED
  DISABLED
  ARCHIVED
  RELEASED
  ERROR
}

enum PhoneWebhookStatus {
  CONFIGURED
  MISSING
  FAILED
  UNKNOWN
}

enum PaymentStatus {
  PENDING
  TRIALING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum ArchitectEarningStatus {
  PENDING
  APPROVED
  REJECTED
}

// Brain Memory — stores what each workflow run and node actually did.
// WorkflowRun = one execution. NodeRun = one step. ContextLink = back-links between steps.

enum WorkflowRunMode {
  TEST // Architect test panel / dry run
  LIVE // Real Twilio, Vapi, or production trigger
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum NodeRunStatus {
  PENDING
  RUNNING
  SUCCESS
  WAITING
  ERROR
  SKIPPED
}

enum ContextLinkType {
  BACKLINK // Load full memory from an earlier node into a later one
  REFERENCE // Soft dependency / traceability
  SUMMARY_SOURCE // Target summary was derived from source node
}

enum ContextLinkStatus {
  ACTIVE
  INACTIVE
  FAILED
}

// One execution of an entire workflow (user clicks Run, or live event fires).
model WorkflowRun {
  id                String             @id @default(cuid())
  workflowId        String
  installedAgentId  String?
  businessId        String?
  triggeredByUserId String?
  mode              WorkflowRunMode    @default(TEST)
  status            WorkflowRunStatus  @default(RUNNING)
  threadId          String?
  inputJson         Json?
  outputJson        Json?
  errorMessage      String?
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workflow          WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  installedAgent    InstalledAgent?    @relation(fields: [installedAgentId], references: [id])
  business          Business?          @relation(fields: [businessId], references: [id])
  triggeredBy       User?              @relation(fields: [triggeredByUserId], references: [id])
  nodeRuns          NodeRun[]
  contextLinks      ContextLink[]
  durationMs        Int? /// Total run duration in milliseconds
  totalTokenInput   Int?               @default(0)
  totalTokenOutput  Int?               @default(0)
  totalCostCents    Int?               @default(0)
  currentNodeId     String? /// Last node that executed in this run
  metadataJson      Json? /// Extra workflow-level metadata

  @@index([currentNodeId])
  @@index([workflowId])
  @@index([installedAgentId])
  @@index([businessId])
  @@index([threadId])
  @@index([status])
  @@index([createdAt])
}

// One execution of a single workflow node — this is where per-step memory lives.
model NodeRun {
  id             String        @id @default(cuid())
  workflowRunId  String
  nodeId         String
  nodeType       String
  nodeLabel      String?
  status         NodeRunStatus @default(PENDING)
  executionOrder Int           @default(0)
  threadId       String?

  inputJson     Json?
  outputJson    Json?
  summary       String?
  variablesJson Json?
  filesJson     Json?

  provider    String?
  model       String?
  costCents   Int?
  tokenInput  Int?
  tokenOutput Int?

  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workflowRun   WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  outgoingLinks ContextLink[] @relation("ContextLinkFrom")
  incomingLinks ContextLink[] @relation("ContextLinkTo")

  @@index([workflowRunId])
  @@index([workflowRunId, nodeId])
  @@index([threadId])
  @@index([status])
}

// Back-link: fromNodeRun = memory source, toNodeRun = node that reads it.
model ContextLink {
  id            String          @id @default(cuid())
  workflowRunId String
  fromNodeRunId String
  toNodeRunId   String
  linkType      ContextLinkType @default(BACKLINK)
  reason        String?
  createdAt     DateTime        @default(now())

  workflowRun WorkflowRun       @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  fromNodeRun NodeRun           @relation("ContextLinkFrom", fields: [fromNodeRunId], references: [id], onDelete: Cascade)
  toNodeRun   NodeRun           @relation("ContextLinkTo", fields: [toNodeRunId], references: [id], onDelete: Cascade)
  linkStatus  ContextLinkStatus @default(ACTIVE)

  @@index([workflowRunId])
  @@index([fromNodeRunId])
  @@index([toNodeRunId])
  @@index([linkStatus])
}

// ---- Proxy email (Amazon SES on reply.triven.ai) ----

enum EmailAliasStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum EmailReplyHandlingMode {
  TRIVEN_INBOX
  FORWARD_ONLY
  TRIVEN_AND_FORWARD
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailMessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
  BOUNCED
  COMPLAINED
  REJECTED
  SUPPRESSED
}

enum EmailPurpose {
  CUSTOMER_FOLLOW_UP
  BOOKING_CONFIRMATION
  CALL_SUMMARY
  INTERNAL_NOTIFICATION
  REPLY
  TEST
}

/// One buyer-branded proxy sender identity (<business-slug>@reply.triven.ai).
model BusinessEmailAlias {
  id                          String                 @id @default(cuid())
  businessId                  String
  installedAgentId            String?
  buyerUserId                 String
  localPart                   String
  domain                      String                 @default("reply.triven.ai")
  emailAddress                String                 @unique
  displayName                 String
  forwardToEmail              String?
  replyHandlingMode           EmailReplyHandlingMode @default(TRIVEN_AND_FORWARD)
  /// Buyer toggle: send customers booking-confirmation / follow-up emails.
  customerConfirmationEnabled Boolean                @default(true)
  /// Buyer toggle: send the team internal call-summary / lead emails.
  internalSummaryEnabled      Boolean                @default(true)
  status                      EmailAliasStatus       @default(ACTIVE)
  provider                    String                 @default("SES")
  sesIdentityStatus           String?
  lastVerifiedAt              DateTime?
  lastError                   String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@index([businessId])
  @@index([status])
}

/// Every proxy email in or out — audit trail, threading, and suppression source.
model EmailMessage {
  id                String             @id @default(cuid())
  businessId        String?
  installedAgentId  String?
  aliasId           String?
  direction         EmailDirection
  fromEmail         String
  toEmail           String
  ccEmails          String[]           @default([])
  bccEmails         String[]           @default([])
  replyToEmail      String?
  subject           String
  textBody          String?
  htmlBody          String?
  providerMessageId String?
  sesMessageId      String?
  threadKey         String?
  inReplyTo         String?
  idempotencyKey    String?            @unique
  status            EmailMessageStatus @default(QUEUED)
  purpose           EmailPurpose       @default(CUSTOMER_FOLLOW_UP)
  metadata          Json?
  sentAt            DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  receivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  alias    BusinessEmailAlias? @relation(fields: [aliasId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([aliasId])
  @@index([sesMessageId])
  @@index([toEmail, status])
}

/// Recipients we must never email again (permanent bounce / complaint / manual block).
model EmailSuppression {
  id           String   @id @default(cuid())
  emailAddress String   @unique
  reason       String
  source       String   @default("SES")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// ---- Platform usage service costs (admin-managed pricing board) ----

enum UsageServiceUnit {
  PER_MINUTE
  PER_SMS
  PER_CALL
  PER_UNIT
}

/// Vendor / infrastructure line item used to bill agent execution (e.g. Twilio, Deepgram).
model PlatformUsageService {
  id                  String           @id @default(cuid())
  code                String           @unique
  name                String
  role                String?
  unit                UsageServiceUnit @default(PER_MINUTE)
  actualCostMicroUsd  Int
  updatedCostMicroUsd Int
  isActive            Boolean          @default(true)
  sortOrder           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([isActive, sortOrder])
}

enum UsageInvoiceStatus {
  OPEN
  OVERDUE
  PAID
  VOID
}

/// Immutable monthly, post-paid usage bill for one business. Call and pricing
/// snapshots are retained so businesses never share or retroactively change costs.
model BusinessUsageInvoice {
  id                    String             @id @default(cuid())
  businessId            String
  billingMonth          String
  invoiceNumber         String             @unique
  status                UsageInvoiceStatus @default(OPEN)
  currency              String             @default("usd")
  periodStart           DateTime
  periodEnd             DateTime
  issuedAt              DateTime
  dueAt                 DateTime
  subtotalMicroUsd      Int
  totalMicroUsd         Int
  paidAt                DateTime?
  stripePaymentIntentId String?
  reminderCount         Int                @default(0)
  lastReminderAt        DateTime?
  suspendedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  business  Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lineItems BusinessUsageInvoiceLineItem[]
  calls     VapiCall[]

  @@unique([businessId, billingMonth])
  @@index([businessId, status])
  @@index([status, dueAt])
}

model BusinessUsageInvoiceLineItem {
  id                String           @id @default(cuid())
  invoiceId         String
  serviceCode       String
  serviceName       String
  unit              UsageServiceUnit
  quantity          Float
  unitPriceMicroUsd Int
  amountMicroUsd    Int
  createdAt         DateTime         @default(now())

  invoice BusinessUsageInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, serviceCode])
  @@index([invoiceId])
}

enum SmsProvider {
  TWILIO
}

enum SmsMessageType {
  APPOINTMENT_CONFIRMATION
  /// Customer-facing cancellation notice — consent-gated like all customer SMS.
  APPOINTMENT_CANCELLATION
  TEST_SMS
  MISSED_CALL_TEXT_BACK
  WORKFLOW_SMS
  /// SMS to the business's own team/staff phone (not a customer message).
  TEAM_NOTIFICATION
}

enum SmsExecutionStatus {
  QUEUED
  ACCEPTED
  SENDING
  SENT
  DELIVERED
  UNDELIVERED
  FAILED
  SIMULATED
  /// Blocked before reaching Twilio — e.g. missing/withdrawn SMS consent.
  /// The suppression reason is stored in errorCode (SMS_CONSENT_REQUIRED / SMS_OPTED_OUT).
  SUPPRESSED
}

model SmsExecution {
  id                   String             @id @default(cuid())
  businessId           String?
  installedAgentId     String?
  appointmentId        String?
  /// Idempotency key, e.g. "appointment-confirmation:{appointmentId}" — the
  /// unique constraint is what makes duplicate triggers safe under concurrency.
  dedupeKey            String?            @unique
  provider             SmsProvider        @default(TWILIO)
  messageSid           String?            @unique
  messagingServiceSid  String?
  messageType          SmsMessageType     @default(WORKFLOW_SMS)
  toPhone              String
  fromPhone            String?
  body                 String
  status               SmsExecutionStatus @default(QUEUED)
  errorCode            String?
  errorMessage         String?
  numSegments          Int?
  providerCostMicroUsd Int?
  currency             String?
  queuedAt             DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([installedAgentId])
  @@index([appointmentId])
  @@index([status])
  @@index([createdAt])
  @@index([toPhone, createdAt])
}

enum SmsConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum SmsConsentMethod {
  /// Verbal affirmative consent captured during an inbound AI-receptionist call.
  VERBAL_CALL
  /// Optional, unchecked-by-default checkbox on a public booking/service-request form.
  WEB_FORM
}

enum SmsConsentPurpose {
  TRANSACTIONAL_BOOKING
}

/// Auditable SMS consent record. Consent is scoped to ONE business + ONE
/// customer phone + ONE messaging program — consent captured for Business A
/// never authorizes messages from Business B. Every business-initiated
/// transactional SMS must pass canSendTransactionalSms() against this table.
model SmsConsent {
  id               String  @id @default(cuid())
  businessId       String
  installedAgentId String?
  /// Customer phone in strict E.164 (validated via validateSmsRecipientE164).
  phoneNumber      String
  /// Messaging program identifier (e.g. TRANSACTIONAL_BOOKING).
  messagingProgram String  @default("TRANSACTIONAL_BOOKING")

  status  SmsConsentStatus
  method  SmsConsentMethod
  purpose SmsConsentPurpose @default(TRANSACTIONAL_BOOKING)

  /// When affirmative consent was captured. Null when the only event so far is
  /// a decline/opt-out (a declined ask is stored as OPTED_OUT with no consentAt).
  consentAt    DateTime?
  optOutAt     DateTime?
  /// What triggered the opt-out: SMS_STOP | VERBAL_DECLINE | ADMIN.
  optOutSource String?

  /// Business name presented to the customer in the disclosure.
  businessNamePresented String?
  /// Version tag of the disclosure script shown/read at consent time.
  disclosureVersion     String
  /// SHA-256 hash of the exact disclosure text presented (immutable evidence).
  disclosureHash        String?

  /// Vapi call id for VERBAL_CALL consent.
  vapiCallId    String?
  /// Appointment / booking / service-request id for WEB_FORM consent.
  appointmentId String?
  /// Public page URL the WEB_FORM consent was submitted from.
  sourceUrl     String?
  /// Request metadata for WEB_FORM consent (where legally appropriate).
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phoneNumber, messagingProgram])
  @@index([phoneNumber])
  @@index([businessId, status])
  @@index([vapiCallId])
  @@index([installedAgentId])
}
