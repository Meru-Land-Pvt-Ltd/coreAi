// One execution of a single workflow node — this is where per-step memory lives.
model NodeRun {
  id             String        @id @default(cuid())
  workflowRunId  String
  nodeId         String
  nodeType       String
  nodeLabel      String?
  status         NodeRunStatus @default(PENDING)
  executionOrder Int           @default(0)
  threadId       String?

  inputJson     Json?
  outputJson    Json?
  summary       String?
  variablesJson Json?
  filesJson     Json?

  provider    String?
  model       String?
  costCents   Int?
  tokenInput  Int?
  tokenOutput Int?

  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?

  /// Did this step return what its node type says it produces?
  /// "proven" | "unproven" | "cannot-tell". Recorded on every run; see
  /// packages/shared/src/node-honesty.ts for why "cannot-tell" is its own
  /// answer rather than a pass.
  honesty        String?
  /// Names it declared and did not return.
  missingOutputs String[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workflowRun   WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  outgoingLinks ContextLink[] @relation("ContextLinkFrom")
  incomingLinks ContextLink[] @relation("ContextLinkTo")

  @@index([workflowRunId])
  @@index([workflowRunId, nodeId])
  @@index([threadId])
  @@index([status])
  @@index([honesty, createdAt])
}

// Back-link: fromNodeRun = memory source, toNodeRun = node that reads it.
model ContextLink {
