  documentName      String?
  documentMimeType  String?
  documentSizeBytes Int?
  documentBytes     Bytes?

  voiceName        String?
  voiceMimeType    String?
  voiceDurationSec Int?
  voiceSizeBytes   Int?
  voiceBytes       Bytes?

  /// OPEN | RESOLVED — free-text status (matches BusinessKnowledgeFile style).
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
