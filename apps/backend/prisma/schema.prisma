/// Platform-wide API credentials and provider settings managed from Admin →
/// Manage API instead of .env, so a key can be rotated without a redeploy.
/// A key absent here falls back to the matching environment variable, which
/// keeps every existing deployment working until an admin fills the form in.
/// Per-architect encrypted secret ("My Keys" locker). Each row is one named
/// key an architect stores once and references by name from an API Call node.
/// The value is AES-256-GCM encrypted with ENCRYPTION_KEY using the shared
/// crypto helper — iv, auth tag and ciphertext are bundled into the single
/// `valueEncrypted` string (same encoding as PlatformApiSetting and the
/// Telegram/Calendly token columns). Plaintext is NEVER stored or returned to
/// the browser; the API only ever exposes a mask.
model ArchitectSecret {
  id              String   @id @default(cuid())
  architectUserId String
  /// Human label the architect chose, e.g. "My Weather API key". Referenced by
  /// name from the API Call node. Unique per architect.
  name            String
  /// AES-256-GCM(iv.authTag.ciphertext) — never returned in plaintext.
  valueEncrypted  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  architect User @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@unique([architectUserId, name])
  @@index([architectUserId])
}

/// One clock per schedule node per installed agent — the timer that lets an
/// agent work with nobody watching. The graph says WHAT runs; this row says
/// WHEN and for WHICH business, because one WorkflowDefinition is shared by
/// every buyer and must never carry one buyer's schedule.
model ScheduledAgentRun {
  id                  String    @id @default(cuid())
  businessId          String
  installedAgentId    String
  workflowId          String
  /// node.id of the trigger.schedule node this clock belongs to.
  nodeId              String
  /// hourly | daily | weekly
  cadence             String    @default("daily")
  /// Wall-clock time in the business's own zone, not UTC.
  hourLocal           Int       @default(9)
  minuteLocal         Int       @default(0)
  /// 0=Sunday .. 6=Saturday. Weekly only.
  weekdayLocal        Int?
  timeZone            String
  /// ACTIVE | PAUSED | PAUSED_FAILING
  status              String    @default("ACTIVE")
  nextRunAt           DateTime
  lastRunAt           DateTime?
  lastWorkflowRunId   String?
  lastError           String?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent InstalledAgent     @relation(fields: [installedAgentId], references: [id], onDelete: Cascade)
  workflow       WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([installedAgentId, nodeId])
  @@index([status, nextRunAt])
  @@index([businessId])
}

/// One private inbound link per webhook node per installed agent. The token is
/// the credential, so only its hash is searchable; the encrypted copy exists
/// solely to show the buyer their URL again on the setup screen.
model AgentWebhookEndpoint {
  id                  String    @id @default(cuid())
  businessId          String
  installedAgentId    String
  workflowId          String
  /// node.id of the trigger.webhook node this link feeds.
  nodeId              String
  /// Set when this address belongs to a Node Frame node declaring
  /// execution "inbound". The connector's own receive() authenticates the
  /// delivery and reads it, instead of the generic signature check.
  connectorId         String?
  /// sha256(token) hex — the lookup column. Verification never decrypts.
  tokenHash           String    @unique
  /// AES-256-GCM of the token, so the buyer can see the link again.
  tokenCipher         String
  /// Optional shared secret; when set, deliveries must carry a valid signature.
  signingSecretCipher String?
  /// ACTIVE | PAUSED
  status              String    @default("ACTIVE")
  lastDeliveryAt      DateTime?
  deliveryCount       Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent InstalledAgent     @relation(fields: [installedAgentId], references: [id], onDelete: Cascade)
  workflow       WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([installedAgentId, nodeId])
  @@index([businessId])
  @@index([status])
}

model PlatformApiSetting {
  id              String   @id @default(cuid())
  /// Environment-variable name, e.g. "OPENAI_API_KEY". Unique.
  key             String   @unique
  /// AES-encrypted with ENCRYPTION_KEY — never stored or returned in plaintext.
  valueEncrypted  String
  /// True for credentials (masked in every API response). False for non-secret
  /// settings like model names and voice ids, which are returned in full.
  secret          Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

/// Admin-controlled palette presentation for architect workflow-builder nodes.
/// Missing rows / null label+group use catalog defaults from @coreai/shared.
model ArchitectNodeVisibility {
  id        String   @id @default(cuid())
  nodeType  String   @unique
  visible   Boolean  @default(true)
  /// Null = catalog label.
  label     String?
  /// Null = catalog group.
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible])
}

/// Admin-created architect palette groups. Catalog groups live in shared code;
/// extra names here survive refresh even before a node is assigned.
model ArchitectNodeGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// Business team / RBAC (plan Parts 1 & 6). One business is no longer one
// login: members are people (optionally linked to a User login) with roles,
// handoff eligibility, and presence. All customerId/teamMemberId link columns
// across older models are indexed strings (no FK) so the additive migration
// never has to backfill or lock existing tables.
// ============================================================================

model BusinessTeamMember {
  id              String    @id @default(cuid())
  businessId      String
  /// Linked login — null for phone-only staff or until an invite is accepted.
  userId          String?
  displayName     String
  email           String?
  phone           String?
  /// OWNER | ADMIN | MANAGER | RECEPTIONIST | SALES | SUPPORT | VIEWER
  role            String    @default("RECEPTIONIST")
  department      String?
  active          Boolean   @default(true)
  handoffEligible Boolean   @default(true)
  /// AVAILABLE | BUSY | OFFLINE
  presence        String    @default("AVAILABLE")
  /// Lower dials first in the handoff cascade.
  priority        Int       @default(100)
  /// Optional per-member permission overrides on top of the role matrix.
  permissionsJson Json?
  lastActiveAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@index([businessId, active, handoffEligible])
  @@index([userId])
}

model BusinessMemberInvite {
  id              String    @id @default(cuid())
  businessId      String
  email           String
  role            String    @default("RECEPTIONIST")
  invitedByUserId String?
  /// sha256 of the invite token — the raw token only ever lives in the email.
  tokenHash       String    @unique
  /// PENDING | ACCEPTED | REVOKED | EXPIRED
  status          String    @default("PENDING")
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId, status])
}

/// Append-only through application paths: business-scoped audit trail for
/// important actions (rules, knowledge, team, integrations, deploy, billing
/// settings). No update/delete route exists for these rows.
model BusinessActivityLog {
  id          String   @id @default(cuid())
  businessId  String
  actorUserId String?
  /// Human label captured at write time so renames/deletes never blank history.
  actorLabel  String?
  action      String
  targetType  String?
  targetId    String?
  detailJson  Json?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, action])
}

// ============================================================================
// Customer domain (plan Part 7): one canonical person per business, linked by
// identities across channels. NEVER matched across businesses.
// ============================================================================

model Customer {
  id           String             @id @default(cuid())
  businessId   String
  displayName  String?
  primaryPhone String?
  primaryEmail String?
  /// ACTIVE | MERGED (row kept for reversibility) | ANONYMOUS
  status       String             @default("ACTIVE")
  mergedIntoId String?
  notes        String?
  firstSeenAt  DateTime           @default(now())
  lastSeenAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  identities   CustomerIdentity[]

  @@index([businessId, lastSeenAt])
  @@index([businessId, primaryPhone])
  @@index([businessId, status])
  @@index([mergedIntoId])
}

model CustomerIdentity {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  /// PHONE | EMAIL | WHATSAPP | TELEGRAM | NAME
  kind       String
  /// Normalized (E.164 phone, lowercased email, provider id).
  value      String
  /// STRONG identities auto-link; WEAK ones only ever suggest.
  confidence String   @default("STRONG")
  source     String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessId, kind, value])
  @@index([customerId])
}

model CustomerMergeSuggestion {
  id               String    @id @default(cuid())
  businessId       String
  customerAId      String
  customerBId      String
  reason           String
  score            Float?
  /// PENDING | MERGED | DISMISSED
  status           String    @default("PENDING")
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([businessId, customerAId, customerBId])
  @@index([businessId, status])
}

/// Every merge is reversible: movedRefsJson records exactly which rows moved
/// from the merged customer so a split can put them back.
model CustomerMergeEvent {
  id                  String    @id @default(cuid())
  businessId          String
  survivingCustomerId String
  mergedCustomerId    String
  movedRefsJson       Json
  mergedByUserId      String?
  reversedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([businessId, createdAt])
}

// ============================================================================
// Handoff cascade (plan Part 1): per-attempt audit under a HandoffEvent.
// ============================================================================

model HandoffAttempt {
  id             String       @id @default(cuid())
  handoffEventId String
  teamMemberId   String?
  destination    String
  attemptOrder   Int
  startedAt      DateTime     @default(now())
  connectedAt    DateTime?
  endedAt        DateTime?
  /// CONNECTED | NO_ANSWER | BUSY | FAILED | SKIPPED
  outcome        String?
  handoffEvent   HandoffEvent @relation(fields: [handoffEventId], references: [id], onDelete: Cascade)

  @@index([handoffEventId, attemptOrder])
}

// ============================================================================
// Rules engine (plan Part 4): owner-defined behavior rules with deterministic
// priority, categories, scheduling, and full version history.
// ============================================================================

model BusinessAgentRule {
  id               String                     @id @default(cuid())
  businessId       String
  installedAgentId String?
  title            String
  instruction      String
  /// COMPLIANCE | SAFETY | BOOKING | ESCALATION | BUSINESS_POLICY | SALES | TONE | CUSTOM
  category         String                     @default("CUSTOM")
  /// Lower wins within a tier; COMPLIANCE/SAFETY always outrank other tiers.
  priority         Int                        @default(100)
  active           Boolean                    @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  version          Int                        @default(1)
  createdByUserId  String?
  updatedByUserId  String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  business         Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions         BusinessAgentRuleVersion[]

  @@index([businessId, active])
  @@index([installedAgentId])
}

model BusinessAgentRuleVersion {
  id              String            @id @default(cuid())
  ruleId          String
  version         Int
  title           String
  instruction     String
  category        String
  priority        Int
  active          Boolean
  startsAt        DateTime?
  endsAt          DateTime?
  changedByUserId String?
  changeNote      String?
  createdAt       DateTime          @default(now())
  rule            BusinessAgentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
}

/// Customer-supplied text that tried to override system/business rules
/// ("ignore your instructions…"). Logged as a security signal, never acted on.
model RuleInjectionAttempt {
  id               String   @id @default(cuid())
  businessId       String
  installedAgentId String?
  channel          String
  callId           String?
  excerpt          String
  createdAt        DateTime @default(now())

  @@index([businessId, createdAt])
}

// ============================================================================
// Knowledge gaps (plan Part 3): questions the AI could not answer.
// ============================================================================

model UnansweredQuestion {
  id               String    @id @default(cuid())
  businessId       String
  installedAgentId String?
  channel          String
  question         String
  /// Normalized dedupe key so repeats count up instead of piling rows.
  normalizedKey    String
  count            Int       @default(1)
  lastAskedAt      DateTime  @default(now())
  /// OPEN | RESOLVED
  status           String    @default("OPEN")
  resolvedByFileId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, normalizedKey])
  @@index([businessId, status])
}

// ============================================================================
// Appointment reminders (plan Part 5): durable scheduled sends with retry
// state — a reminder failure never touches the appointment itself.
// ============================================================================

model AppointmentReminder {
  id            String      @id @default(cuid())
  businessId    String
  appointmentId String
  offsetMinutes Int
  sendAt        DateTime
  channel       String      @default("SMS")
  /// SCHEDULED | RETRYING | SENT | FAILED | CANCELLED | SKIPPED_NO_CONSENT
  status        String      @default("SCHEDULED")
  attempts      Int         @default(0)
  lastError     String?
  sentAt        DateTime?
  providerId    String?
  /// appointmentId:offsetMinutes — one reminder per slot, ever.
  dedupeKey     String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([businessId])
  @@index([appointmentId])
}

// ============================================================================
// Per-step workflow execution (plan Part 5): every step gets its own durable
// status instead of one run-level flag.
// ============================================================================

model WorkflowStepRun {
  id             String      @id @default(cuid())
  workflowRunId  String
  nodeId         String
  label          String?
  /// PENDING | RUNNING | SUCCEEDED | RETRYING | FAILED | SKIPPED
  status         String      @default("PENDING")
  attempts       Int         @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  providerId     String?
  errorCode      String?
  /// Sanitized — never raw provider payloads with PII/secrets.
  errorMessage   String?
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  workflowRun    WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([status])
}

// ============================================================================
// Conversation quality scoring (plan Part 8).
// ============================================================================

model ConversationEvaluation {
  id                      String    @id @default(cuid())
  businessId              String
  installedAgentId        String?
  vapiCallId              String?   @unique
  conversationId          String?
  /// AI | HUMAN | MIXED — same rubric either way.
  handledBy               String    @default("AI")
  rubricVersion           String
  overallScore            Float
  confidence              Float
  dimensionsJson          Json
  coachingJson            Json?
  missedOpportunitiesJson Json?
  evaluator               String
  /// SCORED | UNDER_REVIEW | ADJUSTED | EXCLUDED
  status                  String    @default("SCORED")
  adjustedScore           Float?
  reviewNote              String?
  reviewedByUserId        String?
  reviewedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  business                Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, overallScore])
  @@index([businessId, status])
}

/// ---------------------------------------------------------------------------
/// Customer-context CRM.
///
/// Triven does not replace the customer's CRM — it becomes the AI layer on top
/// of it. HubSpot is the first live adapter; the provider enum and the
/// per-business `isActive` flag exist so Salesforce/Zoho/Pipedrive can be added
/// without reshaping these tables or the buyer UI.
/// ---------------------------------------------------------------------------

enum CrmProvider {
  HUBSPOT
  // Add SALESFORCE, ZOHO, PIPEDRIVE, … in a later migration when that adapter
  // ships. The UI catalog lists coming-soon providers without an enum value.
}

enum CrmConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

model CrmConnection {
  id                    String              @id @default(cuid())
  businessId            String
  provider              CrmProvider         @default(HUBSPOT)
  /// True for the one CRM used for AI lookup + after-call sync. At most one
  /// CONNECTED row per business should be isActive.
  isActive              Boolean             @default(true)
  portalId              String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  expiresAt             DateTime?
  scopes                String?
  status                CrmConnectionStatus @default(PENDING)
  lastSyncedAt          DateTime?
  lastError             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactCache          CrmContactCache[]
  objectMappings        CrmObjectMapping[]

  @@unique([businessId, provider])
  @@index([businessId])
  @@index([businessId, isActive])
  @@index([portalId])
  @@index([status])
}

model CrmContactCache {
  id           String        @id @default(cuid())
  connectionId String
  businessId   String
  /// Provider-side contact id (HubSpot contact id).
  contactId    String
  /// E.164. The only reliable identifier for consumer callers — indexed so a
  /// mid-call lookup stays well under the latency budget.
  phone        String?
  email        String?
  firstName    String?
  lastName     String?
  company      String?
  owner        String?
  stage        String?
  lastActivity DateTime?
  lastSynced   DateTime      @default(now())
  /// Short AI insight line rendered in the table.
  insight      String?
  /// Extra provider properties (vip, preferred language, …).
  payloadJson  Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  connection   CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, contactId])
  @@index([businessId])
  @@index([phone])
  @@index([email])
  @@index([lastSynced])
  @@index([businessId, phone])
}

model CrmObjectMapping {
  id            String        @id @default(cuid())
  connectionId  String
  businessId    String
  /// "lead" | "appointment" | "conversation" | "vapi_call" | "whatsapp_conversation"
  trivenEntity  String
  trivenId      String
  /// "contact" | "deal" | "note" | "task" | "meeting"
  hubspotObject String
  hubspotId     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  connection    CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, trivenEntity, trivenId])
  @@index([businessId])
  @@index([hubspotObject, hubspotId])
}

model CrmWebhookEvent {
  id           String    @id @default(cuid())
  connectionId String?
  businessId   String?
  eventType    String
  payloadJson  Json
  /// PENDING | PROCESSING | DONE | FAILED
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([status, createdAt])
  @@index([businessId])
}

/// A batch of people one installed agent should phone, one at a time.
///
/// The list belongs to the BUSINESS, not to the architect who built the agent.
/// That is deliberate and it is the whole compliance story: the people on it
/// consented to be called by THIS business, and consent does not transfer
/// between companies. The architect never sees these numbers.
model CallList {
  id               String @id @default(cuid())
  businessId       String
  installedAgentId String
  workflowId       String
  /// node.id of the trigger.call_list node this list feeds.
  nodeId           String
  name             String @default("My list")

  /// DRAFT | RUNNING | PAUSED | DONE | STOPPED_BUDGET
  status String @default("DRAFT")

  /// Six is the ceiling: 93% of leads that ever convert are reached by the
  /// sixth attempt, and leads needing 7+ are 45% LESS likely to convert.
  maxAttempts             Int @default(6)
  /// Local hours in the CALLED PARTY's zone. 47 CFR 64.1200(c)(1) forbids
  /// calls before 8am or after 9pm there — these may narrow that, never widen.
  windowStartHour         Int @default(9)
  windowEndHour           Int @default(20)
  /// Ten simultaneous AI calls is ten times the burn per minute, and past the
  /// point where carriers start failing calls in ways that look like silence.
  maxConcurrentCalls      Int @default(3)
  maxCallsPerPersonPerDay Int @default(1)
  /// Hard spend ceiling in whole dollars. 0 disables the cap.
  budgetUsd               Int @default(50)
  spentCents              Int @default(0)

  lastSweptAt DateTime?
  startedAt   DateTime?
  stoppedAt   DateTime?
  stoppedBy   String?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent InstalledAgent     @relation(fields: [installedAgentId], references: [id], onDelete: Cascade)
  workflow       WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  people         CallListPerson[]

  @@index([status, lastSweptAt])
  @@index([businessId])
  @@index([installedAgentId])
}

/// One person on a list, and everything that ever happened to them.
model CallListPerson {
  id       String  @id @default(cuid())
  listId   String
  name     String?
  /// Strict E.164. Unique per list so the same number cannot be queued twice.
  phone    String
  /// IANA zone when we can work it out from the number; null means the engine
  /// must fall back to the conservative window rather than guess.
  timeZone String?
  notes    String?

  /// WAITING | CALLING | RETRY | ANSWERED | BOOKED | NO_ANSWER | VOICEMAIL |
  /// BUSY | FAILED | BAD_NUMBER | OPTED_OUT | SUPPRESSED | DONE
  status        String    @default("WAITING")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  /// Guards "max calls per person per day" across restarts.
  attemptsToday Int       @default(0)
  attemptsDay   String?
  lastOutcome   String?
  lastCallId    String?
  lastError     String?
  bookedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list CallList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, phone])
  @@index([listId, status, nextAttemptAt])
  @@index([phone])
}

/// Numbers this business must never call again, whatever list they appear on.
///
/// Per-person opt-out on a single list is not enough: the same person turns up
/// in next month's export, and rings again. Suppression is per BUSINESS and is
/// checked before every dial.
model CallSuppression {
  id         String   @id @default(cuid())
  businessId String
  phone      String
  reason     String?
  /// Where it came from: a call, a manual add, an import.
  source     String   @default("call")
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@index([phone])
}

/// One run of one connector, for one business.
///
/// The dashboard figures a connector generates ("leads found", "spent on
/// lookups") are read from here. That is the whole reason this table exists:
/// a tile that cannot be filled from a real record would have to be filled
/// with a guess, and a guess on a dashboard is the same lie the engine refuses
/// to write to a log.
model ConnectorRun {
  id               String  @id @default(cuid())
  connectorId      String
  businessId       String?
  installedAgentId String?
  workflowRunId    String?

  ok      Boolean
  /// Machine-readable reason: ok, rate_limited, dishonest_result, ...
  code    String
  message String?

  /// What the run produced — leads found, messages sent. Never the items
  /// themselves: those belong to whichever step chose to store them, under
  /// that step's own retention rules.
  unitsProduced Int @default(0)
  pagesFetched  Int @default(0)
  costCents     Int @default(0)

  isTest     Boolean  @default(false)
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([businessId, connectorId, createdAt])
  @@index([installedAgentId, createdAt])
  @@index([connectorId, createdAt])
}

/// The daily self-test result for one connector.
///
/// This is what replaces a person reading a provider's changelog. A row per
/// day per connector, so "when did Apollo change?" has an answer with a date
/// on it rather than a guess.
model ConnectorHealthCheck {
  id          String   @id @default(cuid())
  connectorId String
  healthy     Boolean
  /// cosmetic | degrades-quality | breaks-agents
  severity    String
  message     String
  missingKeys String[]
  checkedAt   DateTime @default(now())

  @@index([connectorId, checkedAt])
  @@index([healthy, checkedAt])
}

/// A Node Frame an architect filled in through the builder.
///
/// The blank frame is the same one our own connectors use; this is a filled-in
/// copy that lives in one architect's account instead of in the codebase. It is
/// stored as a declaration plus a recipe — never as code — and the platform
/// builds the runnable heart from it and runs the SAME validation every
/// hand-written connector goes through before it appears in their toolkit.
model ArchitectNodeFrame {
  id              String @id @default(cuid())
  architectUserId String
  /// The frame's own id, e.g. "acme.find_things". Unique per architect.
  frameId         String

  /// DRAFT while it still has problems, READY once it validates clean.
  status          String   @default("DRAFT")
  /// The nine declarations plus the request recipe.
  declarationJson Json
  /// Keys the architect supplied, encrypted. Never platform credentials.
  secretsJson     Json?
  /// What validation said last time, so the builder can show it without rerunning.
  problems        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  architect User @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@unique([architectUserId, frameId])
  @@index([architectUserId, status])
}
