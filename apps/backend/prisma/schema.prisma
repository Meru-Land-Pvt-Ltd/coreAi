/// How a person proved they want this business to phone them. An AI voice is
/// an "artificial voice" under the TCPA, so a sales call without one of these
/// is unlawful — this record IS the defence.
enum CallConsentMethod {
  /// They asked to be called on the business's own website or product page.
  WEB_REQUEST
  /// They said yes on a call with this business, captured in the transcript.
  VERBAL_CALL
  /// The business holds written consent gathered elsewhere and attests to it.
  IMPORTED_WRITTEN
  /// The account owner consenting to be called by their own agent (testing).
  OWNER_SELF
}

model CallConsent {
  id               String            @id @default(cuid())
  businessId       String
  installedAgentId String?
  /// Strict E.164. One record per person per business.
  phoneNumber      String
  /// OPTED_IN | OPTED_OUT
  status           String            @default("OPTED_IN")
  method           CallConsentMethod
  /// Where the consent came from: a page URL, a call id, or the owner's note.
  evidence         String?
  /// What they were told they were agreeing to, kept word for word.
  disclosureText   String?
  consentAt        DateTime          @default(now())
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phoneNumber])
  @@index([businessId, status])
}

enum SmsConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum SmsConsentMethod {
  /// Verbal affirmative consent captured during an inbound AI-receptionist call.
  VERBAL_CALL
