generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                       @id @default(cuid())
  email                String
  passwordHash         String?
  role                 UserRole
  fullName             String?
  phone                String?
  location             String?
  timezone             String?
  profilePhotoUrl      String?
  isSuspended          Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  listings             AgentListing[]
  architectProfile     ArchitectProfile?
  businesses           Business[]
  connectorCredentials ConnectorCredential[]
  payments             Payment[]
  proposals            ProjectProposal[]
  templateRequests     TemplateRequest[]
  workflows            WorkflowDefinition[]
  workflowRuns         WorkflowRun[]
  payoutMethod         ArchitectPayoutMethod?
  backupPayoutMethod   ArchitectBackupPayoutMethod?
  payouts              ArchitectPayout[]
  earnings             ArchitectEarning[]
  ledgerEntries        ArchitectLedgerEntry[]
  loginHistory         UserLoginHistory[]
  activeSessions       UserActiveSession[]
  roleMemberships      UserRoleMembership[]
  memoryRecords        MemoryRecord[]
  whatsappConnections  WhatsAppConnection[]
  platformApiSettings  PlatformApiSetting[]
  teamMemberships      BusinessTeamMember[]
  architectSecrets     ArchitectSecret[]
  nodeFrames           ArchitectNodeFrame[]

  @@unique([email, role])
  @@index([role])
  @@index([createdAt])
}

/// Capability grants: one row per (user, role). `User.role` is kept only as
/// the legacy/primary role for compatibility — authorization checks read this
/// table, so a single account can be ARCHITECT and BUSINESS at once.
model UserRoleMembership {
  id        String   @id @default(cuid())
  userId    String
  role      UserRole
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model ArchitectProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  title               String?
  displayName         String?
  marketplacePhotoUrl String?
  tagline             String?
  bio                 String?
  portfolioUrl        String?
  githubUrl           String?
  linkedinUrl         String?
  twitterHandle       String?
  experienceBand      String?
  skills              String[]
  approvalStatus      ArchitectStatus @default(PENDING)
  rating              Float           @default(0)
  completedJobs       Int             @default(0)
  notificationPrefs   Json?
  privacyPrefs        Json?
  payoutSchedule      Json?
  agentsPaused        Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  hourlyRateCents     Int?
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
}

model WorkflowDefinition {
  id                   String                 @id @default(cuid())
  name                 String
  description          String?
  workflowJson         Json
  configureJson        Json?
  marketplaceJson      Json?
  requiredIntegrations Json?
  buyerSetupSchema     Json?
  publishChecklist     Json?
  reviewStatus         ListingReviewStatus    @default(DRAFT)
  publishStatus        ListingPublishStatus   @default(DRAFT)
  isTemplate           Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  architectUserId      String
  listings             AgentListing[]
  installedAgents      InstalledAgent[]
  workflowRuns         WorkflowRun[]
  memoryRecords        MemoryRecord[]
  scheduledRuns        ScheduledAgentRun[]
  callLists            CallList[]
  webhookEndpoints     AgentWebhookEndpoint[]
  architect            User                   @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([architectUserId])
  @@index([createdAt])
}

model AgentListing {
  id                     String               @id @default(cuid())
  name                   String
  shortDescription       String
  description            String?
  priceCents             Int                  @default(0)
  /// The Stripe Product for this agent, created once on its first sale.
  stripeProductId        String?
  /// The Stripe Price the buyer is actually charged. Stripe prices are
  /// immutable, so changing priceCents mints a NEW price and repoints this —
  /// existing subscribers keep the price they agreed to, which is both the
  /// law in most places and the only decent way to treat a customer.
  stripePriceId          String?
  /// The amount stripePriceId represents, so price drift is detectable.
  stripePriceCents       Int?
  status                 ListingStatus        @default(DRAFT)
  featuredAt             DateTime?
  requiredConnectors     String[]
  supportedLlms          String[]
  tags                   String[]
  tagline                String?
  category               String?
  industryTags           String[]             @default([])
  iconUrl                String?
  fullDescription        String?
  includedFeatures       String[]             @default([])
  screenshotUrls         String[]             @default([])
  demoVideoUrl           String?
  pricingModel           PricingModel         @default(SUBSCRIPTION)
  executionFeeCents      Int                  @default(0)
  freeTrialEnabled       Boolean              @default(false)
  trialDays              Int                  @default(0)
  setupTimeEstimate      String?
  requiredIntegrations   Json?
  requiredBuyerSetup     Json?
  buyerSetupInstructions String?
  installInstructions    String?
  dataHandling           Json?
  complianceChecks       Json?
  reviewStatus           ListingReviewStatus  @default(DRAFT)
  publishStatus          ListingPublishStatus @default(DRAFT)
  rejectionReason        String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  publishedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  architectUserId        String
  workflowId             String?
  architect              User                 @relation(fields: [architectUserId], references: [id], onDelete: Cascade)
  workflow               WorkflowDefinition?  @relation(fields: [workflowId], references: [id])
  installedAgents        InstalledAgent[]
  payments               Payment[]
  publishedPage          PublishedAgentPage?

  @@index([architectUserId])
  @@index([workflowId])
  @@index([status])
  @@index([status, createdAt])
}

/// Public hosted page for a published agent (triven.ai/a/<slug>): customers
/// try the agent in sandboxed demo mode and follow the CTA into the purchase
/// funnel. One page per approved listing; the architect customizes template
/// and copy from the workflow's manage screen.
model PublishedAgentPage {
  id               String       @id @default(cuid())
  slug             String       @unique
  listingId        String       @unique
  workflowId       String
  architectUserId  String
  template         String       @default("chat")
  headline         String?
  welcomeMessage   String?
  suggestedPrompts String[]
  accentColor      String?
  /// Design Brain dials (theme, composer position, density, bubble style,
  /// history sidebar). Null = all defaults; always read through resolveDesign.
  designJson       Json?
  /// Product Spec (packages/shared/src/product-spec.ts): the multi-page site
  /// the AI architect designed, wires included. Null = no spec yet; the page
  /// still renders from a spec synthesized off the Face Blueprint. Always read
  /// through getProductSpec / resolveProductForPublic, never raw.
  productJson      Json?
  /// The BUYER's daily dashboard, composed by Smart Designer from the same
  /// graph (business-dashboard-composer.ts). Numbers are stored as
  /// {{metric.key}} tokens and filled with live figures on every open, so one
  /// stored spec always shows today's results.
  dashboardJson    Json?
  /// The BUYER's setup form, composed by Smart Designer from the same graph.
  /// Paired with dashboardJson: one asks the business for what the agent needs,
  /// the other shows them what it did. Neither is hand-written anywhere.
  setupJson        Json?
  status           String       @default("LIVE")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  listing          AgentListing @relation(fields: [listingId], references: [id])

  @@index([workflowId])
  @@index([architectUserId])
}

model Project {
  id                 String            @id @default(cuid())
  title              String
  requirementBrief   String
  requiredConnectors String[]
  preferredLlms      String[]
  budgetMinCents     Int?
  budgetMaxCents     Int?
  status             ProjectStatus     @default(OPEN)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  proposals          ProjectProposal[]

  @@index([status])
  @@index([createdAt])
}

model ProjectProposal {
  id              String         @id @default(cuid())
  projectId       String
  architectUserId String
  coverLetter     String
  bidAmountCents  Int?
  etaDays         Int?
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  architect       User           @relation(fields: [architectUserId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, architectUserId])
  @@index([architectUserId])
  @@index([projectId])
  @@index([status])
}

model ConnectorCredential {
  id                   String            @id @default(cuid())
  userId               String
  provider             ConnectorProvider
  externalAccountEmail String?
  accessTokenEnc       String?
  refreshTokenEnc      String?
  scope                String?
  tokenType            String?
  expiresAt            DateTime?
  /// Provider-specific JSON (e.g. Calendly userUri, organizationUri, webhookSigningKey).
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model EmailVerificationCode {
  id               String    @id @default(cuid())
  email            String
  role             UserRole
  codeHash         String
  attempts         Int       @default(0)
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  codeCipher       String?
  linkTokenHash    String?   @unique
  originDeviceHash String?

  @@index([email, role])
  @@index([expiresAt])
  @@index([createdAt])
}

model Business {
  id                String   @id @default(cuid())
  ownerId           String
  name              String
  type              String
  publicBookingSlug String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   @default("active")
  subscriptionPriceId  String?
  currentPeriodEnd     DateTime?

  billingName                    String?
  billingEmail                   String?
  billingAddress                 String?
  billingPostalCode              String?
  spendingAlertEnabled           Boolean   @default(false)
  spendingAlertThresholdCents    Int       @default(5000)
  spendingAlertLastNotifiedMonth String?
  spendingAlertLastNotifiedAt    DateTime?
  /// Hard monthly ceiling on live AI usage. null = platform default
  /// (LIVE_USAGE_HARD_CAP_CENTS); 0 = explicitly unlimited.
  usageHardCapCents              Int?
  usageCapNotifiedMonth          String?
  usageCapNotifiedAt             DateTime?
  /// Days to keep recordings/transcripts/summaries. null = keep indefinitely.
  recordingRetentionDays         Int?
  billingExempt                  Boolean   @default(false)

  appointments        Appointment[]
  owner               User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  knowledgeBases      BusinessKnowledgeBase[]
  knowledgeFiles      BusinessKnowledgeFile[]
  phoneNumbers        BusinessPhoneNumber[]
  profile             BusinessProfile?
  conversations       Conversation[]
  installedAgents     InstalledAgent[]
  leads               Lead[]
  vapiCalls           VapiCall[]
  usageInvoices       BusinessUsageInvoice[]
  payments            Payment[]
  workflowRuns        WorkflowRun[]
  emailAliases        BusinessEmailAlias[]
  emailMessages       EmailMessage[]
  smsExecutions       SmsExecution[]
  smsConsents         SmsConsent[]
  specialHours        BusinessSpecialHours[]
  executionUsages     AgentUsageExecution[]
  memoryRecords       MemoryRecord[]
  telegramBots        TelegramBotConnection[]
  telegramStates      TelegramConversationState[]
  telegramActions     TelegramMessageExecution[]
  businessServices    BusinessService[]
  handoffEvents       HandoffEvent[]
  scheduledRuns       ScheduledAgentRun[]
  webhookEndpoints    AgentWebhookEndpoint[]
  callConsents        CallConsent[]
  callLists           CallList[]
  callSuppressions    CallSuppression[]
  teamMembers         BusinessTeamMember[]
  memberInvites       BusinessMemberInvite[]
  activityLogs        BusinessActivityLog[]
  customers           Customer[]
  agentRules          BusinessAgentRule[]
  unansweredQuestions UnansweredQuestion[]
  evaluations         ConversationEvaluation[]
  crmConnections      CrmConnection[]

  @@index([ownerId])
  @@index([type])
}

model BusinessProfile {
  id                    String    @id @default(cuid())
  businessId            String    @unique
  serviceArea           String?
  bookingUrl            String?
  teamPhone             String?
  businessSize          String?
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  onboardingDataJson    Json?
  hoursJson             Json?
  tone                  String    @default("friendly")
  escalationRules       String?
  services              String[]
  faqsJson              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  calendarId            String?   @default("primary")
  timeZone              String    @default("America/New_York")
  vapiAssistantId       String?
  vapiPhoneNumberId     String?
  /// The ONE authoritative structured Business Address — Business Settings and
  /// Agent Setup both read/write these columns, so they can never diverge.
  addressLine1          String?
  addressLine2          String?
  addressCity           String?
  addressState          String?
  addressPostalCode     String?
  addressCountry        String?
  addressLandmark       String?
  addressDirections     String?
  addressMapsLink       String?
  /// "manual" | "pdf_suggestion" — where the current value came from.
  addressSource         String?
  /// Set when the buyer explicitly confirmed the address.
  addressConfirmedAt    DateTime?
  /// "manual" | "pdf_suggestion" — where the weekly hours came from.
  hoursSource           String?
  /// Set when the buyer explicitly confirmed the weekly Business Hours.
  /// While null, agents must say hours are not confirmed — never guess.
  hoursConfirmedAt      DateTime?
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// Date-specific overrides of the weekly Business Hours: holiday closures,
/// one-day special hours, temporary closures. One row per (business, date);
/// the date is a calendar date in the business timezone.
model BusinessSpecialHours {
  id               String          @id @default(cuid())
  businessId       String
  installedAgentId String?
  /// "YYYY-MM-DD" calendar date in the business timezone.
  date             String
  /// "holiday" | "special" | "closure"
  kind             String          @default("special")
  closed           Boolean         @default(true)
  /// [{ open: "HH:mm", close: "HH:mm" }, …] when not closed.
  periodsJson      Json?
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent   InstalledAgent? @relation(fields: [installedAgentId], references: [id], onDelete: Cascade)

  @@unique([businessId, installedAgentId, date])
  @@index([businessId])
  @@index([installedAgentId])
}

model BusinessPhoneNumber {
  id                   String            @id @default(cuid())
  businessId           String
  installedAgentId     String?
  phoneNumber          String            @unique
  provider             ConnectorProvider @default(TWILIO)
  twilioPhoneNumberSid String?
  forwardToPhone       String?
  isActive             Boolean           @default(true)
  configJson           Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  business             Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent       InstalledAgent?   @relation(fields: [installedAgentId], references: [id])

  @@index([businessId])
  @@index([installedAgentId])
  @@index([isActive])
}

model InstalledAgent {
  id                        String                      @id @default(cuid())
  businessId                String
  workflowId                String
  listingId                 String?
  name                      String
  status                    String                      @default("ACTIVE")
  pausedAt                  DateTime?
  installSource             InstallSource               @default(MARKETPLACE_PURCHASE)
  executionFeeCents         Int                         @default(0)
  trialExecutionLimit       Int                         @default(50)
  trialExecutionsUsed       Int                         @default(0)
  executionBillingStartedAt DateTime                    @default(now())
  configJson                Json?
  /// sha256 of the public embed key. Present once the buyer has taken the
  /// snippet for their own website; its presence is what lets that widget do
  /// real work (book, save a lead) instead of running as a demo.
  embedKeyHash              String?                     @unique
  /// Encrypted copy of the same key, so the buyer can read their snippet again.
  embedKeyCipher            String?
  /// Per-day ceiling of live widget runs for this install. Null = platform
  /// default. The key is public by nature (it sits in the buyer's HTML), so
  /// THIS is the guard that actually protects the bill.
  embedDailyLimit           Int?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  phoneNumbers              BusinessPhoneNumber[]
  knowledgeFiles            BusinessKnowledgeFile[]
  specialHours              BusinessSpecialHours[]
  business                  Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing                   AgentListing?               @relation(fields: [listingId], references: [id])
  workflow                  WorkflowDefinition          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowRuns              WorkflowRun[]
  executionUsages           AgentUsageExecution[]
  usageInvoices             BusinessUsageInvoice[]
  payments                  Payment[]
  memoryRecords             MemoryRecord[]
  telegramBot               TelegramBotConnection?
  telegramStates            TelegramConversationState[]
  telegramActions           TelegramMessageExecution[]
  businessServices          BusinessService[]
  appointments              Appointment[]
  callLists                 CallList[]
  scheduledRuns             ScheduledAgentRun[]
  webhookEndpoints          AgentWebhookEndpoint[]

  @@unique([businessId, listingId])
  @@index([businessId])
  @@index([workflowId])
  @@index([listingId])
  @@index([status])
}

/// One dedicated Telegram bot for one installed agent. Bot access tokens and
/// webhook secrets are AES-GCM encrypted before they reach these columns.
model TelegramBotConnection {
  id                         String                      @id @default(cuid())
  businessId                 String
  installedAgentId           String                      @unique
  requestedUsername          String                      @unique
  webhookConnectionId        String                      @unique @default(cuid())
  botUserId                  String?                     @unique
  botUsername                String?                     @unique
  botDisplayName             String
  botTokenEncrypted          String?
  webhookSecretEncrypted     String
  managerBotId               String?
  provisioningMode           String                      @default("MANAGED")
  provisioningStatus         String                      @default("PENDING_APPROVAL")
  webhookStatus              String                      @default("PENDING")
  setupNonceHash             String?
  telegramOwnerUserId        String?
  ownerChatId                String?
  ownerNotificationStatus    String                      @default("NOT_CONNECTED")
  ownerNotificationNonceHash String?
  status                     String                      @default("PENDING")
  lastWebhookAt              DateTime?
  lastSuccessfulSendAt       DateTime?
  lastProviderErrorCode      String?
  lastError                  String?
  credentialRotatedAt        DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  business                   Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent             InstalledAgent              @relation(fields: [installedAgentId], references: [id], onDelete: Cascade)
  conversationStates         TelegramConversationState[]
  processedUpdates           TelegramProcessedUpdate[]
  messageExecutions          TelegramMessageExecution[]

  @@index([businessId])
  @@index([status])
  @@index([telegramOwnerUserId, status])
}

model TelegramConversationState {
  id                   String                @id @default(cuid())
  businessId           String
  installedAgentId     String
  telegramConnectionId String
  telegramBotId        String
  telegramChatId       String
  telegramUserId       String
  chatStatus           String                @default("ACTIVE")
  lastDeliveryError    String?
  state                String                @default("STARTED")
  contextJson          Json?
  expiresAt            DateTime
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent       InstalledAgent        @relation(fields: [installedAgentId], references: [id], onDelete: Cascade)
  telegramConnection   TelegramBotConnection @relation(fields: [telegramConnectionId], references: [id], onDelete: Cascade)

  @@unique([businessId, installedAgentId, telegramConnectionId, telegramChatId])
  @@index([telegramConnectionId, telegramUserId])
  @@index([telegramConnectionId, chatStatus])
  @@index([expiresAt])
}

model TelegramProcessedUpdate {
  id                   String                @id @default(cuid())
  telegramConnectionId String
  updateId             String
  status               String                @default("RECEIVED")
  payloadJson          Json
  workflowRunId        String?
  errorCode            String?
  errorMessage         String?
  attempts             Int                   @default(0)
  processedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  telegramConnection   TelegramBotConnection @relation(fields: [telegramConnectionId], references: [id], onDelete: Cascade)

  @@unique([telegramConnectionId, updateId])
  @@index([status, createdAt])
}

model TelegramMessageExecution {
  id                   String                @id @default(cuid())
  workflowExecutionId  String?
  nodeId               String
  businessId           String
  installedAgentId     String
  telegramConnectionId String
  chatId               String
  messageId            String?
  idempotencyKey       String?               @unique
  actionType           String
  status               String                @default("PENDING")
  requestJson          Json?
  responseJson         Json?
  errorCode            String?
  errorMessage         String?
  attempts             Int                   @default(0)
  createdAt            DateTime              @default(now())
  sentAt               DateTime?
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent       InstalledAgent        @relation(fields: [installedAgentId], references: [id], onDelete: Cascade)
  telegramConnection   TelegramBotConnection @relation(fields: [telegramConnectionId], references: [id], onDelete: Cascade)

  @@index([telegramConnectionId, status])
  @@index([businessId, installedAgentId, createdAt])
}

model BusinessService {
  id                   String          @id @default(cuid())
  businessId           String
  installedAgentId     String?
  slug                 String
  name                 String
  description          String?
  durationMinutes      Int             @default(30)
  priceCents           Int?
  priceVisible         Boolean         @default(false)
  active               Boolean         @default(true)
  calendarId           String?
  routingRuleJson      Json?
  staffMappingJson     Json?
  bufferMinutes        Int             @default(10)
  minimumNoticeMinutes Int             @default(0)
  maximumAdvanceDays   Int             @default(30)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent       InstalledAgent? @relation(fields: [installedAgentId], references: [id], onDelete: Cascade)

  @@unique([businessId, installedAgentId, slug])
  @@index([businessId, installedAgentId, active])
}

model BusinessKnowledgeBase {
  id               String                 @id @default(cuid())
  businessId       String
  title            String
  content          String
  contentJson      Json?
  /// Set when this entry was extracted from an uploaded document — deleting
  /// the file cascades away every chunk derived from it.
  sourceFileId     String?
  /// Deterministic chunk position within the source document (0-based).
  chunkIndex       Int?
  /// Page/section label when the extractor could attribute one.
  sourceSection    String?
  installedAgentId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceFile       BusinessKnowledgeFile? @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([sourceFileId])
  @@index([businessId, installedAgentId])
}

/// A buyer-uploaded knowledge document (PDF/DOCX/TXT). Raw bytes are kept so
/// reprocessing works without external storage; list APIs never return them.
model BusinessKnowledgeFile {
  id               String                  @id @default(cuid())
  businessId       String
  installedAgentId String?
  filename         String
  mimeType         String
  sizeBytes        Int
  /// Reserved for future object-storage moves; bytes currently live in contentBytes.
  storageKey       String?
  contentBytes     Bytes
  /// sha256 of the raw bytes — re-uploading the same document is idempotent.
  contentHash      String
  /// UPLOADING | PROCESSING | PROCESSED | FAILED
  status           String                  @default("PROCESSING")
  /// ACTIVE serves answers; ARCHIVED is kept but never retrieved (plan Part 3 versioning).
  lifecycle        String                  @default("ACTIVE")
  /// CUSTOMER_VISIBLE | INTERNAL_ONLY — internal docs never reach customer AI.
  visibility       String                  @default("CUSTOMER_VISIBLE")
  version          Int                     @default(1)
  /// The file this one replaced (auto-archived on replacement).
  supersedesId     String?
  /// UPLOAD | URL | CSV | IMAGE | DRIVE | NOTION | YOUTUBE
  sourceType       String                  @default("UPLOAD")
  sourceUrl        String?
  pageCount        Int?
  extractedChars   Int                     @default(0)
  chunkCount       Int                     @default(0)
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  business         Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent   InstalledAgent?         @relation(fields: [installedAgentId], references: [id], onDelete: SetNull)
  knowledgeChunks  BusinessKnowledgeBase[]

  @@unique([businessId, installedAgentId, contentHash])
  @@index([businessId])
  @@index([installedAgentId])
}

model Conversation {
  id                   String                @id @default(cuid())
  businessId           String
  channel              String
  customerPhone        String
  status               String                @default("OPEN")
  /// Shared-inbox state machine: AI_ACTIVE | WAITING_FOR_HUMAN | HUMAN_ACTIVE | RETURNED_TO_AI | CLOSED
  aiState              String                @default("AI_ACTIVE")
  /// BusinessTeamMember.id currently handling this thread (HUMAN_ACTIVE).
  assignedTeamMemberId String?
  waitingSince         DateTime?
  humanSince           DateTime?
  slaEscalatedAt       DateTime?
  /// Canonical Customer.id (per business). Plain indexed link — no FK.
  customerId           String?
  /// Structured conversation understanding (plan Part 2).
  outcome              String?
  sentiment            String?
  summary              String?
  lastInboundAt        DateTime?
  lastOutboundAt       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages             ConversationMessage[]

  @@unique([businessId, channel, customerPhone])
  @@index([businessId])
  @@index([customerPhone])
  @@index([channel, customerPhone])
  @@index([businessId, aiState])
  @@index([customerId])
}

