model WorkflowRun {
  id                String             @id @default(cuid())
  workflowId        String
  installedAgentId  String?
  businessId        String?
  triggeredByUserId String?
  mode              WorkflowRunMode    @default(TEST)
  status            WorkflowRunStatus  @default(RUNNING)
  threadId          String?
  inputJson         Json?
  outputJson        Json?
  errorMessage      String?
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workflow          WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  installedAgent    InstalledAgent?    @relation(fields: [installedAgentId], references: [id])
  business          Business?          @relation(fields: [businessId], references: [id])
  triggeredBy       User?              @relation(fields: [triggeredByUserId], references: [id])
  nodeRuns          NodeRun[]
  contextLinks      ContextLink[]
  durationMs        Int? /// Total run duration in milliseconds
  totalTokenInput   Int?               @default(0)
  totalTokenOutput  Int?               @default(0)
  totalCostCents    Int?               @default(0)
  currentNodeId     String? /// Last node that executed in this run
  metadataJson      Json? /// Extra workflow-level metadata
  callProvider      String?
  externalCallId    String?

  @@unique([callProvider, externalCallId])
  @@index([currentNodeId])
  @@index([workflowId])
  @@index([installedAgentId])
  @@index([businessId])
  @@index([threadId])
  @@index([status])
  @@index([createdAt])
}

// One execution of a single workflow node — this is where per-step memory lives.
model NodeRun {
  id             String        @id @default(cuid())
  workflowRunId  String
  nodeId         String
  nodeType       String
  nodeLabel      String?
  status         NodeRunStatus @default(PENDING)
  executionOrder Int           @default(0)
  threadId       String?

  inputJson     Json?
  outputJson    Json?
  summary       String?
  variablesJson Json?
  filesJson     Json?

  provider    String?
  model       String?
  costCents   Int?
  tokenInput  Int?
  tokenOutput Int?

  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workflowRun   WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  outgoingLinks ContextLink[] @relation("ContextLinkFrom")
  incomingLinks ContextLink[] @relation("ContextLinkTo")

  @@index([workflowRunId])
  @@index([workflowRunId, nodeId])
  @@index([threadId])
  @@index([status])
}

// Back-link: fromNodeRun = memory source, toNodeRun = node that reads it.
model ContextLink {
  id            String          @id @default(cuid())
  workflowRunId String
  fromNodeRunId String
  toNodeRunId   String
  linkType      ContextLinkType @default(BACKLINK)
  reason        String?
  createdAt     DateTime        @default(now())

  workflowRun WorkflowRun       @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  fromNodeRun NodeRun           @relation("ContextLinkFrom", fields: [fromNodeRunId], references: [id], onDelete: Cascade)
  toNodeRun   NodeRun           @relation("ContextLinkTo", fields: [toNodeRunId], references: [id], onDelete: Cascade)
  linkStatus  ContextLinkStatus @default(ACTIVE)

  @@index([workflowRunId])
  @@index([fromNodeRunId])
  @@index([toNodeRunId])
  @@index([linkStatus])
}

