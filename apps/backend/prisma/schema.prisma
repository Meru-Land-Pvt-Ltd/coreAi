}

model ArchitectPayoutMethod {
  id                      String    @id @default(cuid())
  architectUserId         String    @unique
  bankName                String?
  accountHolderName       String?
  accountNumber           String? // Legacy only. New Stripe Connect methods never store a full account number.
  ifscCode                String? // Legacy only. Stripe collects IFSC/ABA routing details directly.
  country                 String    @default("IN")
  currency                String    @default("inr")
  accountLast4            String?
  routingLast4            String?
  stripeAccountId         String?   @unique
  stripeExternalAccountId String?
  verificationStatus      String    @default("PENDING")
  payoutsEnabled          Boolean   @default(false)
  detailsSubmitted        Boolean   @default(false)
  /// Which Stripe mode the connected account belongs to. A test-mode account
  /// must never receive live transfers (and vice versa).
  livemode                Boolean   @default(false)
  /// Stripe capability status for "transfers" (active | pending | inactive).
  transfersCapability     String?
  requirementsJson        Json?
  disabledReason          String?
  onboardingCompletedAt   DateTime?
  lastSyncedAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  architect               User      @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([country])
  @@index([verificationStatus])
  @@index([livemode])
}

model ArchitectBackupPayoutMethod {
  id                      String   @id @default(cuid())
  architectUserId         String   @unique
  bankName                String?
  accountHolderName       String?
  country                 String   @default("IN")
  currency                String   @default("inr")
  accountLast4            String?
  routingLast4            String?
  stripeAccountId         String?
  stripeExternalAccountId String?
  verificationStatus      String   @default("PENDING")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  architect               User     @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([country])
}

model ArchitectPayout {
  id                         String                @id @default(cuid())
  architectUserId            String
  amountCents                Int
  /// Stripe payout fee (e.g. Instant Payout fee), from the balance transaction.
  feeCents                   Int?
  /// amountCents - feeCents once known.
  netCents                   Int?
  currency                   String                @default("usd")
  status                     ArchitectPayoutStatus @default(PENDING)
  stripeTransferId           String?               @unique
  stripePayoutId             String?               @unique
  stripeBalanceTransactionId String?
  stripeConnectedAccountId   String?
  livemode                   Boolean               @default(false)
  /// MANUAL = requested in Triven; AUTOMATIC = created by the Stripe payout schedule.
  origin                     ArchitectPayoutOrigin @default(MANUAL)
  arrivalDate                DateTime?
  failureCode                String?
  /// Safe, user-displayable failure text only — never a raw Stripe exception.
  failureMessage             String?
  deliveryMethod             String                @default("standard")
  destinationType            String?
  destinationLast4           String?
  /// Client-generated idempotency token; unique per architect+method+mode.
  clientRequestId            String?
  /// Deterministic Stripe idempotency key used for payouts.create.
  idempotencyKey             String?
  paidAt                     DateTime?
  failedAt                   DateTime?
  canceledAt                 DateTime?
  reversedAt                 DateTime?
  /// Stripe event.created of the last applied webhook — stale events are ignored.
  lastStripeEventCreatedAt   DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  architect                  User                  @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@unique([architectUserId, clientRequestId, deliveryMethod, livemode])
  @@index([architectUserId])
  @@index([architectUserId, createdAt])
  @@index([status])
  @@index([stripeConnectedAccountId])
  @@index([livemode])
  @@index([createdAt])
}

model UserLoginHistory {
