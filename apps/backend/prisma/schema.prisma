enum SmsProvider {
  TWILIO
}

enum SmsMessageType {
  APPOINTMENT_CONFIRMATION
  /// Customer-facing cancellation notice — consent-gated like all customer SMS.
  APPOINTMENT_CANCELLATION
  TEST_SMS
  MISSED_CALL_TEXT_BACK
  WORKFLOW_SMS
  /// SMS to the business's own team/staff phone (not a customer message).
  TEAM_NOTIFICATION
}

enum SmsExecutionStatus {
  QUEUED
  ACCEPTED
  SENDING
  SENT
  DELIVERED
  UNDELIVERED
  FAILED
  SIMULATED
  /// Blocked before reaching Twilio — e.g. missing/withdrawn SMS consent.
  /// The suppression reason is stored in errorCode (SMS_CONSENT_REQUIRED / SMS_OPTED_OUT).
  SUPPRESSED
}

model SmsExecution {
  id                   String             @id @default(cuid())
  businessId           String?
  installedAgentId     String?
  appointmentId        String?
  /// Idempotency key, e.g. "appointment-confirmation:{appointmentId}" — the
  /// unique constraint is what makes duplicate triggers safe under concurrency.
  dedupeKey            String?            @unique
  provider             SmsProvider        @default(TWILIO)
  messageSid           String?            @unique
  messagingServiceSid  String?
  messageType          SmsMessageType     @default(WORKFLOW_SMS)
  toPhone              String
  fromPhone            String?
  body                 String
  status               SmsExecutionStatus @default(QUEUED)
  errorCode            String?
  errorMessage         String?
  numSegments          Int?
  providerCostMicroUsd Int?
  currency             String?
  queuedAt             DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([installedAgentId])
  @@index([appointmentId])
  @@index([status])
  @@index([createdAt])
  @@index([toPhone, createdAt])
}

enum SmsConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum SmsConsentMethod {
  /// Verbal affirmative consent captured during an inbound AI-receptionist call.
  VERBAL_CALL
  /// Optional, unchecked-by-default checkbox on a public booking/service-request form.
  WEB_FORM
}

enum SmsConsentPurpose {
  TRANSACTIONAL_BOOKING
}

model SmsConsent {
  id               String  @id @default(cuid())
  businessId       String
  installedAgentId String?
  /// Customer phone in strict E.164 (validated via validateSmsRecipientE164).
  phoneNumber      String
  /// Messaging program identifier (e.g. TRANSACTIONAL_BOOKING).
  messagingProgram String  @default("TRANSACTIONAL_BOOKING")

  status  SmsConsentStatus
  method  SmsConsentMethod
  purpose SmsConsentPurpose @default(TRANSACTIONAL_BOOKING)

  consentAt    DateTime?
  optOutAt     DateTime?
  optOutSource String?

  businessNamePresented String?
  disclosureVersion     String
  disclosureHash        String?

  /// Vapi call id for VERBAL_CALL consent.
  vapiCallId    String?
  /// Appointment / booking / service-request id for WEB_FORM consent.
  appointmentId String?
  /// Public page URL the WEB_FORM consent was submitted from.
  sourceUrl     String?
  /// Request metadata for WEB_FORM consent (where legally appropriate).
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phoneNumber, messagingProgram])
  @@index([phoneNumber])
  @@index([businessId, status])
  @@index([vapiCallId])
  @@index([installedAgentId])
}
