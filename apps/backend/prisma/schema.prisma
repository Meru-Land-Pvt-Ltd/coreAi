generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                       @id @default(cuid())
  email                String
  passwordHash         String?
  role                 UserRole
  fullName             String?
  phone                String?
  location             String?
  timezone             String?
  profilePhotoUrl      String?
  isSuspended          Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  listings             AgentListing[]
  architectProfile     ArchitectProfile?
  businesses           Business[]
  connectorCredentials ConnectorCredential[]
  payments             Payment[]
  proposals            ProjectProposal[]
  templateRequests     TemplateRequest[]
  workflows            WorkflowDefinition[]
  workflowRuns         WorkflowRun[]
  payoutMethod         ArchitectPayoutMethod?
  backupPayoutMethod   ArchitectBackupPayoutMethod?
  payouts              ArchitectPayout[]
  earnings             ArchitectEarning[]
  ledgerEntries        ArchitectLedgerEntry[]
  loginHistory         UserLoginHistory[]
  activeSessions       UserActiveSession[]
  roleMemberships      UserRoleMembership[]

  @@unique([email, role])
  @@index([role])
  @@index([createdAt])
}

/// Capability grants: one row per (user, role). `User.role` is kept only as
/// the legacy/primary role for compatibility — authorization checks read this
/// table, so a single account can be ARCHITECT and BUSINESS at once.
model UserRoleMembership {
  id        String   @id @default(cuid())
  userId    String
  role      UserRole
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model ArchitectProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  title               String?
  displayName         String?
  marketplacePhotoUrl String?
  tagline             String?
  bio                 String?
  portfolioUrl        String?
  githubUrl           String?
  linkedinUrl         String?
  twitterHandle       String?
  experienceBand      String?
  skills              String[]
  approvalStatus      ArchitectStatus @default(PENDING)
  rating              Float           @default(0)
  completedJobs       Int             @default(0)
  notificationPrefs   Json?
  privacyPrefs        Json?
  payoutSchedule      Json?
  agentsPaused        Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  hourlyRateCents     Int?
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
}

model WorkflowDefinition {
  id                   String               @id @default(cuid())
  name                 String
  description          String?
  workflowJson         Json
  configureJson        Json?
  marketplaceJson      Json?
  requiredIntegrations Json?
  buyerSetupSchema     Json?
  publishChecklist     Json?
  reviewStatus         ListingReviewStatus  @default(DRAFT)
  publishStatus        ListingPublishStatus @default(DRAFT)
  isTemplate           Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  architectUserId      String
  listings             AgentListing[]
  installedAgents      InstalledAgent[]
  workflowRuns         WorkflowRun[]
  architect            User                 @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([architectUserId])
  @@index([createdAt])
}

model AgentListing {
  id                     String               @id @default(cuid())
  name                   String
  shortDescription       String
  description            String?
  priceCents             Int                  @default(0)
  status                 ListingStatus        @default(DRAFT)
  requiredConnectors     String[]
  supportedLlms          String[]
  tags                   String[]
  tagline                String?
  category               String?
  industryTags           String[]             @default([])
  iconUrl                String?
  fullDescription        String?
  includedFeatures       String[]             @default([])
  screenshotUrls         String[]             @default([])
  demoVideoUrl           String?
  pricingModel           PricingModel         @default(SUBSCRIPTION)
  executionFeeCents      Int                  @default(0)
  freeTrialEnabled       Boolean              @default(false)
  trialDays              Int                  @default(0)
  setupTimeEstimate      String?
  requiredIntegrations   Json?
  requiredBuyerSetup     Json?
  buyerSetupInstructions String?
  installInstructions    String?
  dataHandling           Json?
  complianceChecks       Json?
  reviewStatus           ListingReviewStatus  @default(DRAFT)
  publishStatus          ListingPublishStatus @default(DRAFT)
  rejectionReason        String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  publishedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  architectUserId        String
  workflowId             String?
  architect              User                 @relation(fields: [architectUserId], references: [id], onDelete: Cascade)
  workflow               WorkflowDefinition?  @relation(fields: [workflowId], references: [id])
  installedAgents        InstalledAgent[]
  payments               Payment[]

  @@index([architectUserId])
  @@index([workflowId])
  @@index([status])
}

model Project {
  id                 String            @id @default(cuid())
  title              String
  requirementBrief   String
  requiredConnectors String[]
  preferredLlms      String[]
  budgetMinCents     Int?
  budgetMaxCents     Int?
  status             ProjectStatus     @default(OPEN)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  proposals          ProjectProposal[]

  @@index([status])
  @@index([createdAt])
}

model ProjectProposal {
  id              String         @id @default(cuid())
  projectId       String
  architectUserId String
  coverLetter     String
  bidAmountCents  Int?
  etaDays         Int?
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  architect       User           @relation(fields: [architectUserId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, architectUserId])
  @@index([architectUserId])
  @@index([projectId])
  @@index([status])
}

model ConnectorCredential {
  id                   String            @id @default(cuid())
  userId               String
  provider             ConnectorProvider
  externalAccountEmail String?
  accessTokenEnc       String?
  refreshTokenEnc      String?
  scope                String?
  tokenType            String?
  expiresAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  email      String
  role       UserRole
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email, role])
  @@index([expiresAt])
  @@index([createdAt])
}

model Business {
  id                String   @id @default(cuid())
  ownerId           String
  name              String
  type              String
  publicBookingSlug String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   @default("active")
  subscriptionPriceId  String?
  currentPeriodEnd     DateTime?

  billingName       String?
  billingEmail      String?
  billingAddress    String?
  billingPostalCode String?

  appointments    Appointment[]
  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  knowledgeBases  BusinessKnowledgeBase[]
  knowledgeFiles  BusinessKnowledgeFile[]
  phoneNumbers    BusinessPhoneNumber[]
  profile         BusinessProfile?
  conversations   Conversation[]
  installedAgents InstalledAgent[]
  leads           Lead[]
  vapiCalls       VapiCall[]
  usageInvoices   BusinessUsageInvoice[]
  payments        Payment[]
  workflowRuns    WorkflowRun[]
  emailAliases    BusinessEmailAlias[]
  emailMessages   EmailMessage[]
  smsExecutions   SmsExecution[]
  smsConsents     SmsConsent[]

  @@index([ownerId])
  @@index([type])
}

model BusinessProfile {
  id                    String    @id @default(cuid())
  businessId            String    @unique
  serviceArea           String?
  bookingUrl            String?
  teamPhone             String?
  businessSize          String?
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  onboardingDataJson    Json?
  hoursJson             Json?
  tone                  String    @default("friendly")
  escalationRules       String?
  services              String[]
  faqsJson              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  calendarId            String?   @default("primary")
  timeZone              String    @default("America/New_York")
  vapiAssistantId       String?
  vapiPhoneNumberId     String?
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessPhoneNumber {
  id                   String            @id @default(cuid())
  businessId           String
  installedAgentId     String?
  phoneNumber          String            @unique
  provider             ConnectorProvider @default(TWILIO)
  twilioPhoneNumberSid String?
  forwardToPhone       String?
  isActive             Boolean           @default(true)
  configJson           Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  business             Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent       InstalledAgent?   @relation(fields: [installedAgentId], references: [id])

  @@index([businessId])
  @@index([installedAgentId])
  @@index([isActive])
}

model InstalledAgent {
  id             String                  @id @default(cuid())
  businessId     String
  workflowId     String
  listingId      String?
  name           String
  status         String                  @default("ACTIVE")
  installSource  InstallSource           @default(MARKETPLACE_PURCHASE)
  configJson     Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  phoneNumbers   BusinessPhoneNumber[]
  knowledgeFiles BusinessKnowledgeFile[]
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing        AgentListing?           @relation(fields: [listingId], references: [id])
  workflow       WorkflowDefinition      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowRuns   WorkflowRun[]

  @@unique([businessId, listingId])
  @@index([businessId])
  @@index([workflowId])
  @@index([listingId])
  @@index([status])
}

model BusinessKnowledgeBase {
  id            String                 @id @default(cuid())
  businessId    String
  title         String
  content       String
  contentJson   Json?
  /// Set when this entry was extracted from an uploaded document — deleting
  /// the file cascades away every chunk derived from it.
  sourceFileId  String?
  /// Deterministic chunk position within the source document (0-based).
  chunkIndex    Int?
  /// Page/section label when the extractor could attribute one.
  sourceSection String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceFile    BusinessKnowledgeFile? @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([sourceFileId])
}

/// A buyer-uploaded knowledge document (PDF/DOCX/TXT). Raw bytes are kept so
/// reprocessing works without external storage; list APIs never return them.
model BusinessKnowledgeFile {
  id               String                  @id @default(cuid())
  businessId       String
  installedAgentId String?
  filename         String
  mimeType         String
  sizeBytes        Int
  /// Reserved for future object-storage moves; bytes currently live in contentBytes.
  storageKey       String?
  contentBytes     Bytes
  /// sha256 of the raw bytes — re-uploading the same document is idempotent.
  contentHash      String
  /// UPLOADING | PROCESSING | PROCESSED | FAILED
  status           String                  @default("PROCESSING")
  extractedChars   Int                     @default(0)
  chunkCount       Int                     @default(0)
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  business         Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  installedAgent   InstalledAgent?         @relation(fields: [installedAgentId], references: [id], onDelete: SetNull)
  knowledgeChunks  BusinessKnowledgeBase[]

  @@unique([businessId, contentHash])
  @@index([businessId])
  @@index([installedAgentId])
}

model Conversation {
  id            String                @id @default(cuid())
  businessId    String
  channel       String
  customerPhone String
  status        String                @default("OPEN")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]

  @@unique([businessId, channel, customerPhone])
  @@index([businessId])
  @@index([customerPhone])
  @@index([channel, customerPhone])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  direction      String
  body           String
  providerId     String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Lead {
  id             String   @id @default(cuid())
  businessId     String
  conversationId String?
  phoneNumber    String
  name           String?
  source         String
  status         String   @default("NEW")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phoneNumber])
  @@index([businessId])
  @@index([phoneNumber])
  @@index([status])
}

model Appointment {
  id                 String    @id @default(cuid())
  businessId         String
  conversationId     String?
  customerPhone      String
  customerName       String?
  service            String?
  startAt            DateTime
  endAt              DateTime
  timeZone           String?
  calendarEventId    String?
  calendarEventLink  String?
  status             String    @default("BOOKED")
  notes              String?
  cancelledAt        DateTime?
  cancellationSource String?
  cancellationReason String?
  cancellationCallId String?
  executionMode      String    @default("LIVE")
  testSessionId      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerPhone])
  @@index([startAt])
  @@index([calendarEventId])
  @@index([executionMode])
}

model TestCalendarEvent {
  id               String    @id @default(cuid())
  executionMode    String
  ownerUserId      String
  businessId       String?
  installedAgentId String?
  workflowId       String?
  workflowRunId    String?
  testSessionId    String?
  serviceName      String
  customerName     String?
  customerPhone    String?
  startAt          DateTime
  endAt            DateTime
  timeZone         String
  calendarId       String?
  /// Null for simulated events (no provider write happened).
  googleEventId    String?
  htmlLink         String?
  /// SIMULATED | CREATED | DELETED
  status           String    @default("CREATED")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ownerUserId])
  @@index([businessId])
  @@index([testSessionId])
  @@index([executionMode])
}

model VapiCall {
  id                    String                @id @default(cuid())
  businessId            String
  installedAgentId      String?
  conversationId        String?
  callId                String                @unique
  customerPhone         String
  executionMode         String                @default("LIVE")
  status                String                @default("STARTED")
  transcript            String?
  summary               String?
  recordingUrl          String?
  metadataJson          Json?
  durationSeconds       Int?
  durationMinutes       Float?
  smsCount              Int                   @default(0)
  vapiCostMicroUsd      Int?
  actualCostMicroUsd    Int?
  billedCostMicroUsd    Int?
  usageLineItemsJson    Json?
  vapiCostBreakdownJson Json?
  billingMonth          String?
  billingRecordedAt     DateTime?
  usageInvoiceId        String?
  startedAt             DateTime              @default(now())
  endedAt               DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  business              Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  usageInvoice          BusinessUsageInvoice? @relation(fields: [usageInvoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, billingMonth])
  @@index([businessId, executionMode])
  @@index([installedAgentId])
  @@index([usageInvoiceId])
  @@index([customerPhone])
  @@index([status])
}

model PlatformPhoneNumber {
  id                  String              @id @default(cuid())
  phoneNumber         String              @unique
  /// Normalized E.164 form of phoneNumber (backfilled; canonical for lookups going forward).
  e164                String?             @unique
  provider            ConnectorProvider   @default(TWILIO)
  status              PlatformPhoneStatus @default(AVAILABLE)
  twilioSid           String?             @unique
  /// Provider-agnostic number id (alias for twilioSid; future non-Twilio providers).
  providerNumberId    String?
  country             String?
  region              String?
  locality            String?
  /// e.g. { "voice": true, "sms": false, "mms": false }
  capabilities        Json?
  voiceEnabled        Boolean             @default(true)
  smsEnabled          Boolean             @default(true)
  mmsEnabled          Boolean?
  businessId          String?
  buyerUserId         String?
  installedAgentId    String?
  assignedAt          DateTime?
  /// When the one-time number fee was billed to the buyer (once per number;
  /// cleared when the number returns to AVAILABLE).
  feeBilledAt         DateTime?
  /// Admin provisioning metadata (numbers purchased through the admin panel).
  purchasedByAdminId  String?
  purchasedAt         DateTime?
  releasedAt          DateTime?
  voiceWebhookUrl     String?
  smsWebhookUrl       String?
  webhookStatus       PhoneWebhookStatus  @default(UNKNOWN)
  complianceStatus    String?
  a2pStatus           String?
  isPlatformSmsSender Boolean             @default(false)
  lastSyncedAt        DateTime?
  lastError           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status])
  @@index([businessId])
  @@index([installedAgentId])
  @@index([isPlatformSmsSender, status])
}

/// Structured record of privileged admin actions (phone provisioning, assignment, release…).
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  metaJson    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
}

model Payment {
  id                               String                 @id @default(cuid())
  userId                           String
  businessId                       String?
  listingId                        String?
  amountCents                      Int                    @default(0)
  currency                         String                 @default("usd")
  status                           PaymentStatus          @default(PENDING)
  architectEarningStatus           ArchitectEarningStatus @default(PENDING)
  architectEarningReviewedAt       DateTime?
  architectEarningReviewedByUserId String?

  stripeCustomerId     String?
  stripeSessionId      String?
  stripeSubscriptionId String?
  stripePaymentId      String?

  billingName    String?
  billingEmail   String?
  billingAddress String?

  description   String?
  /// Buyer-facing fee breakdown: [{ label, amountCents }] — agent price plus
  /// the "AI Receptionist No." number fee when one was provisioned.
  lineItemsJson Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  listing  AgentListing?     @relation(fields: [listingId], references: [id])
  earning  ArchitectEarning?

  @@index([userId])
  @@index([businessId])
  @@index([listingId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSessionId])
  @@index([stripeSubscriptionId])
}

model TemplateRequest {
  id              String   @id @default(cuid())
  architectUserId String
  industry        String
  description     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  architect User @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([architectUserId])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([subject])
  @@index([createdAt])
}

model Country {
  id          String   @id @default(cuid())
  name        String
  countryCode String   @unique
  flag        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model ArchitectPayoutMethod {
  id                      String    @id @default(cuid())
  architectUserId         String    @unique
  bankName                String?
  accountHolderName       String?
  accountNumber           String? // Legacy only. New Stripe Connect methods never store a full account number.
  ifscCode                String? // Legacy only. Stripe collects IFSC/ABA routing details directly.
  country                 String    @default("IN")
  currency                String    @default("inr")
  accountLast4            String?
  routingLast4            String?
  stripeAccountId         String?   @unique
  stripeExternalAccountId String?
  verificationStatus      String    @default("PENDING")
  payoutsEnabled          Boolean   @default(false)
  detailsSubmitted        Boolean   @default(false)
  /// Which Stripe mode the connected account belongs to. A test-mode account
  /// must never receive live transfers (and vice versa).
  livemode                Boolean   @default(false)
  /// Stripe capability status for "transfers" (active | pending | inactive).
  transfersCapability     String?
  requirementsJson        Json?
  disabledReason          String?
  onboardingCompletedAt   DateTime?
  lastSyncedAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  architect               User      @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([country])
  @@index([verificationStatus])
  @@index([livemode])
}

model ArchitectBackupPayoutMethod {
  id                      String   @id @default(cuid())
  architectUserId         String   @unique
  bankName                String?
  accountHolderName       String?
  country                 String   @default("IN")
  currency                String   @default("inr")
  accountLast4            String?
  routingLast4            String?
  stripeAccountId         String?
  stripeExternalAccountId String?
  verificationStatus      String   @default("PENDING")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  architect               User     @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@index([country])
}

model ArchitectPayout {
  id                         String                @id @default(cuid())
  architectUserId            String
  amountCents                Int
  /// Stripe payout fee (e.g. Instant Payout fee), from the balance transaction.
  feeCents                   Int?
  /// amountCents - feeCents once known.
  netCents                   Int?
  currency                   String                @default("usd")
  status                     ArchitectPayoutStatus @default(PENDING)
  stripeTransferId           String?               @unique
  stripePayoutId             String?               @unique
  stripeBalanceTransactionId String?
  stripeConnectedAccountId   String?
  livemode                   Boolean               @default(false)
  /// MANUAL = requested in Triven; AUTOMATIC = created by the Stripe payout schedule.
  origin                     ArchitectPayoutOrigin @default(MANUAL)
  arrivalDate                DateTime?
  failureCode                String?
  /// Safe, user-displayable failure text only — never a raw Stripe exception.
  failureMessage             String?
  deliveryMethod             String                @default("standard")
  destinationType            String?
  destinationLast4           String?
  /// Client-generated idempotency token; unique per architect+method+mode.
  clientRequestId            String?
  /// Deterministic Stripe idempotency key used for payouts.create.
  idempotencyKey             String?
  paidAt                     DateTime?
  failedAt                   DateTime?
  canceledAt                 DateTime?
  reversedAt                 DateTime?
  /// Stripe event.created of the last applied webhook — stale events are ignored.
  lastStripeEventCreatedAt   DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  architect                  User                  @relation(fields: [architectUserId], references: [id], onDelete: Cascade)

  @@unique([architectUserId, clientRequestId, deliveryMethod, livemode])
  @@index([architectUserId])
  @@index([architectUserId, createdAt])
  @@index([status])
  @@index([stripeConnectedAccountId])
  @@index([livemode])
  @@index([createdAt])
}

model UserLoginHistory {
  id          String             @id @default(cuid())
  userId      String
  deviceLabel String
  location    String?
  ipMasked    String?
  userAgent   String?
  status      LoginHistoryStatus @default(SUCCESS)
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UserActiveSession {
  id           String    @id @default(cuid())
  userId       String
  tokenSid     String    @unique
  deviceLabel  String
  location     String?
  ipMasked     String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
